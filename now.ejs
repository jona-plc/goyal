<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Goyal Boarding House — Welcome</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">

  <!-- Fonts + Icons + Bootstrap -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- AOS (Animate On Scroll) -->
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">

<style>
  :root {
    --gold: #d4af37;
    --gold-2: #ffd700;
    --bg: #fdfbf6;
    --muted: #556;
    --accent-blue: #0a6ef0;
  }

  /* GLOBAL FIX — prevents horizontal scroll */
  html, body {
    width: 100%;
    overflow-x: hidden !important;
    margin: 0;
    padding: 0;
  }
  * {
    box-sizing: border-box;
    max-width: 100%;
  }

  body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg);
    color: #232323;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* NAVBAR */
  .navbar {
    background: rgba(0,0,0,0.6);
    transition: all .35s ease;
    backdrop-filter: blur(6px);
    width: 100%;
    overflow-x: hidden;
  }
  .navbar.scrolled { background:#000; box-shadow:0 6px 24px rgba(0,0,0,0.35) }
  .navbar-brand { color:var(--gold-2) !important; font-weight:700; letter-spacing:.6px }
  .nav-link { color:#fff !important; font-weight:500 }
  .nav-link:hover { color:var(--gold-2) !important; transform:translateY(-1px) }
  .btn-login {
    background:linear-gradient(45deg,var(--gold),var(--gold-2));
    color:#000;
    border-radius:30px;
    padding:.45rem 1.05rem;
    font-weight:600;
    border:0;
  }

  /* HERO */
  .hero {
    height: 100vh;
    min-height: 720px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    text-align: center;
    color: #fff;
    background-image: url('goyal-bh.jpg');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    filter: saturate(0.95);
    overflow: hidden;
  }
  .hero::before {
    content:"";
    position:absolute; inset:0;
    background: linear-gradient(180deg, rgba(0,0,0,0.55), rgba(0,0,0,0.7));
    z-index:1;
  }
  .hero .hero-inner {
    position:relative; z-index:2; max-width:1100px; padding:20px;
  }
  .hero h1 {
    font-size: clamp(2rem, 4vw, 3.4rem);
    margin-bottom:.6rem;
    font-weight:800;
    line-height:1.02;
    background: linear-gradient(90deg, #cfa800, #ffd700, #fff1b2);
    -webkit-background-clip:text; background-clip:text;
    color:transparent;
    text-transform:none;
    filter: drop-shadow(0 6px 18px rgba(0,0,0,0.35));
  }
  .hero p {
    font-size:1.05rem; color:#f7f7f7;
    max-width:820px; margin:0 auto 1.25rem; opacity:.95;
  }

  .hero .cta {
    display:inline-flex; gap:.7rem; align-items:center;
  }
  .btn-cta {
    background:linear-gradient(45deg, var(--gold), var(--gold-2));
    color:#000; border-radius:28px; padding:.8rem 1.4rem; font-weight:700;
    box-shadow:0 8px 30px rgba(212,175,55,0.18);
  }
  .btn-ghost {
    background:transparent; border:2px solid rgba(255,255,255,0.14);
    color:#fff; padding:.7rem 1.1rem; border-radius:24px;
  }

  .hero .ribbon {
    position:absolute; right:-8%; top:10%;
    width:260px; height:260px; opacity:.08;
    filter:blur(18px);
    background:radial-gradient(circle at 30% 30%, rgba(255,230,128,1), rgba(255,230,128,0.2) 30%, transparent 60%);
    transform:rotate(-20deg);
    z-index:0;
    animation:ribbonFloat 6s ease-in-out infinite;
  }
  @keyframes ribbonFloat {
    0% { transform: translateY(0) rotate(-18deg) }
    50% { transform: translateY(-20px) rotate(-24deg) }
    100% { transform: translateY(0) rotate(-18deg) }
  }

  /* SECTION */
  section { padding: clamp(60px,7vw,110px) 20px; opacity:0; transform:translateY(30px); transition: all .9s cubic-bezier(.2,.9,.2,1); }
  section.show { opacity:1; transform:translateY(0) }

  .container-lg { max-width:1140px; margin:0 auto }

  .section-title {
    text-align:center; color:var(--gold);
    font-weight:700; font-size:1.7rem; margin-bottom:1rem;
  }

  /* ABOUT */
  .about-grid { display:grid; grid-template-columns:1fr 1fr; gap:36px; align-items:center; }
  .about-img { border-radius:14px; overflow:hidden; box-shadow:0 18px 40px rgba(12,12,12,0.14); }
  .about-img img { width:100%; height:100%; object-fit:cover; min-height:320px; display:block; transition:transform .6s ease; }
  .about-card { padding:24px; background:#fff; border-radius:14px; box-shadow:0 10px 30px rgba(0,0,0,0.05); }
  .about-highlights { display:flex; gap:14px; flex-wrap:wrap; margin-top:16px; }
  .about-chip { display:flex; gap:10px; align-items:center; background:linear-gradient(180deg,#fff,#fffaf0); border-radius:12px; padding:10px 12px; box-shadow:0 6px 18px rgba(0,0,0,0.04); }
  .about-chip i { color:var(--gold); font-size:1.3rem; }

  /* ROOMS */
  .rooms-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:22px; }
  .room-card { background:#fff; border-radius:14px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.06); transition: transform .32s ease, box-shadow .32s ease; }
  .room-media { height:200px; overflow:hidden; }
  .room-media img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
  .room-body { padding:18px; }
  .room-title { font-weight:700; color:#222; }
  .room-price { margin-top:8px; font-weight:700; color:var(--accent-blue); }
  .room-card:hover { transform:translateY(-10px); box-shadow:0 18px 50px rgba(0,0,0,0.12); }
  .room-card:hover .room-media img { transform:scale(1.06); }

  /* RULES */
  .rules-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px; }
  .rule-card { background:linear-gradient(180deg,#fff,#fffdf5); border-radius:12px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); border-left:6px solid var(--gold); transition:transform .35s ease, box-shadow .35s ease; }
  .rule-card:hover { transform:translateY(-8px); box-shadow:0 20px 50px rgba(0,0,0,0.12); }
  .rule-icon { width:56px; height:56px; border-radius:12px; display:inline-grid; place-items:center; background:linear-gradient(135deg,rgba(212,175,55,0.14),rgba(255,215,0,0.06)); font-size:1.4rem; color:var(--gold); }

  /* GCASH */
  #gcash {
    background:linear-gradient(135deg,#062b5f 0%, #0a52d8 45%, #0a6ef0 100%);
    color:#fff; border-radius:14px; padding:40px; position:relative;
    box-shadow:0 18px 60px rgba(10,110,240,0.12);
    overflow:hidden;
  }
  #gcash .gcash-inner { display:flex; gap:30px; align-items:center; justify-content:center; flex-wrap:wrap; }
  .gcash-card { display:flex; gap:18px; align-items:center; background:rgba(255,255,255,0.06); padding:20px; border-radius:12px; min-width:320px; box-shadow:inset 0 1px 0 rgba(255,255,255,0.02); }
  .gcash-logo { width:120px; height:120px; display:grid; place-items:center; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 12px 30px rgba(0,0,0,0.12); }
  .gcash-logo img { max-width:80%; }
  .gcash-cta { display:flex; flex-direction:column; gap:10px; align-items:flex-start; }
  .btn-qr { background:rgba(255,255,255,0.95); color:#012; border-radius:10px; padding:.55rem .9rem; font-weight:700; }

  /* CONTACT & FOOTER */
  .contact-box { background:#fff; padding:26px; border-radius:14px; box-shadow:0 12px 40px rgba(0,0,0,0.06); text-align:center; }
  footer { padding:26px; text-align:center; color:#ddd; background:#000; margin-top:8px; }

  /* RESPONSIVE FIXES */
  @media (max-width:900px) {
    .about-grid { grid-template-columns:1fr; gap:20px; }
    .hero { min-height:680px; }
  }

  @media (max-width:768px) {
    .navbar-nav {
      text-align:center;
      background:rgba(0,0,0,0.85);
      border-radius:10px;
      padding:10px 0;
    }
    .hero {
      height:auto;
      min-height:500px;
      padding:80px 20px;
    }
    .hero h1 { font-size:1.9rem; }
    .hero p { font-size:0.95rem; }
    .cta { flex-direction:column; gap:10px; }
    .about-grid { grid-template-columns:1fr; gap:20px; }
    .gcash-inner { flex-direction:column; text-align:center; }
    .gcash-card { width:100%; min-width:auto; }
    .gcash-logo { width:100px; height:100px; }
    .rules-grid { grid-template-columns:1fr; }
    .contact-box { padding:20px; }
    footer { font-size:0.9rem; }
  }

  @media (max-width:480px) {
    .hero h1 { font-size:1.6rem; }
    .btn-cta, .btn-ghost { padding:0.6rem 1rem; font-size:0.9rem; }
    .room-card { font-size:0.9rem; }
  }
</style>

</head>
<body>

  <!-- NAV -->
  <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container container-lg">
      <a class="navbar-brand" href="#">GBH</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
          <li class="nav-item"><a class="nav-link" href="#rooms">Rooms</a></li>
          <li class="nav-item"><a class="nav-link" href="#rules">Rules</a></li>
          <li class="nav-item"><a class="nav-link" href="#gcash">Payments</a></li>
          <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
          <li class="nav-item ms-3"><a class="btn btn-login" href="/login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <header class="hero" id="home">
    <div class="ribbon" aria-hidden="true"></div>
    <div class="hero-inner" data-aos="zoom-in" data-aos-delay="120">
      <h1>Welcome to Goyal Boarding House</h1>
      <p>Comfortable, secure, and affordable living for students and professionals in Zone 8 Bulan Sorsogon City. Fully furnished rooms, strong Wi-Fi, and friendly management.</p>

      <div class="cta">
        <a class="btn btn-cta me-2" href="#inquiry">Inquire Now</a>
        <a class="btn btn-ghost" href="#rooms">View Rooms</a>
      </div>
    </div>
  </header>

  <!-- ABOUT -->
  <section id="about" class="bg-section" data-aos="fade-up">
    <div class="container container-lg">
      <div class="section-title">About Us</div>

      <div class="about-grid">
        <div class="about-img" data-aos="fade-right" data-aos-delay="120">
          <!-- replace about-image.jpg -->
          <img src="goyal-bh.jpg" alt="Goyal Boarding House image">
        </div>

        <div class="about-card" data-aos="fade-left" data-aos-delay="200">
          <h3 style="margin-bottom:.4rem">A Home Away From Home</h3>
          <p style="color:var(--muted); line-height:1.7">
            Goyal Boarding House provides safe, clean, and welcoming accommodation in the heart of Sorsogon City.
            We serve students and working professionals with affordable rates, well-maintained rooms, secure premises, and fast Wi-Fi.
          </p>

          <div class="about-highlights">
            <div class="about-chip"><i class="bi bi-wifi"></i><div><strong>Free Wi-Fi</strong><div style="font-size:.85rem;color:#666">24/7 reliable</div></div></div>
            <div class="about-chip"><i class="bi bi-lock"></i><div><strong>Secure</strong><div style="font-size:.85rem;color:#666">CCTV & gated</div></div></div>
            <div class="about-chip"><i class="bi bi-thermometer-sun"></i><div><strong>Comfort</strong><div style="font-size:.85rem;color:#666">Furnished rooms</div></div></div>
          </div>

          <div style="margin-top:18px">
            <a href="#rooms" class="btn btn-cta">See Rooms</a>
            <a href="#contact" class="btn btn-ghost ms-2">Contact Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROOMS -->
  <section id="rooms" data-aos="fade-up">
    <div class="container container-lg">
      <div class="section-title">Available Rooms & Rates</div>

      <div class="rooms-grid" id="roomsGrid">
        <!-- Single Room -->
        <div class="room-card" data-room-id="single" data-aos="zoom-in" data-aos-delay="100">
          <div class="room-media"><img src="double-room1.jpg" alt="Single Room"></div>
          <div class="room-body">
            <div class="room-title">Double Deck</div>
            <div class="room-price">₱1300-1500 per bed/ upper/lower </div>
            <div class="room-cta">
              <a class="btn btn-cta" href="#inquiry" onclick="prefillInquiry('Single Room')">Book Now</a>
            </div>
          </div>
        </div>

        <!-- Double Room -->
        <div class="room-card" data-room-id="double" data-aos="zoom-in" data-aos-delay="160">
          <div class="room-media"><img src="double-room2.jpg" alt="Double Room"></div>
          <div class="room-body">
            <div class="room-title">Double Deck</div>
            <div class="room-cta">
            </div>
          </div>
        </div>

        <!-- Triple Room -->
        <div class="room-card" data-room-id="triple" data-aos="zoom-in" data-aos-delay="220">
          <div class="room-media"><img src="double-room.jpg" alt="Triple Room"></div>
          <div class="room-body">
            <div class="room-title">Double Deck</div>
              <div class="room-price">This room features 2 double-deck beds (bunk beds)  perfect for 4 tenants. Each bed has a top and bottom bunk, providing privacy and comfort for everyone. </div>
            <div class="room-cta">
              <a class="btn btn-cta" href="#inquiry" onclick="prefillInquiry('Triple Room')">Book Now</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GCASH PAYMENT -->
  <section id="gcash" data-aos="fade-up">
    <div class="container container-lg">
      <div class="section-title text-white">We Accept GCash Payments</div>

      <div class="gcash-inner">
        <div class="gcash-card" data-gsap="pulse">
          <div class="gcash-logo">
            <!-- small formatted logo; replace or use your asset -->
            <img src="https://tse1.mm.bing.net/th/id/OIP.6fX2So9vKYRn990uLJ2nhQHaDt?pid=Api&P=0&h=220" alt="GCash Logo">
          </div>

          <div class="gcash-cta">
            <h3 style="color:#fff; margin:0">Pay Easily via GCash</h3>
           <p style="max-width:520px; color:rgba(235,245,255,0.92)">
  Pay your rent instantly and securely. Our system automatically generates a payment link that directs your payment straight to our GCash account. no owner approval needed. Fast, contactless, and hassle-free.
</p>

            <div style="display:flex; gap:10px;">
              <button class="btn btn-qr" id="showQrBtn"><i class="bi bi-qr-code-scan me-2"></i>Show QR</button>
              <a class="btn btn-ghost" href="#contact">Need Help?</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RULES -->
  <section id="rules" data-aos="fade-up">
    <div class="container container-lg">
      <div class="section-title">House Rules & Regulations</div>

      <div class="rules-grid" id="rulesGrid">
        <div class="rule-card" data-rule="quiet">
          <div style="display:flex; gap:12px; align-items:center">
            <div class="rule-icon"><i class="bi bi-moon-stars"></i></div>
            <div>
              <h5 style="margin:0">Quiet Hours</h5>
              <p style="margin:6px 0 0; color:var(--muted)">Maintain quiet from <strong>10:00 PM</strong> to <strong>6:00 AM</strong>.</p>
            </div>
          </div>
        </div>

        <div class="rule-card" data-rule="visitors">
          <div style="display:flex; gap:12px; align-items:center">
            <div class="rule-icon"><i class="bi bi-people"></i></div>
            <div>
              <h5 style="margin:0">Visitor Policy</h5>
              <p style="margin:6px 0 0; color:var(--muted)">Visitors allowed until <strong>9:00 PM</strong>. No overnight stays without approval.</p>
            </div>
          </div>
        </div>

        <div class="rule-card" data-rule="no-smoking">
          <div style="display:flex; gap:12px; align-items:center">
            <div class="rule-icon"><i class="bi bi-x-circle"></i></div>
            <div>
              <h5 style="margin:0">No Smoking / No Alcohol</h5>
              <p style="margin:6px 0 0; color:var(--muted)">Smoking and alcohol consumption inside premises are strictly prohibited.</p>
            </div>
          </div>
        </div>

        <div class="rule-card" data-rule="payments">
          <div style="display:flex; gap:12px; align-items:center">
            <div class="rule-icon"><i class="bi bi-wallet2"></i></div>
            <div>
              <h5 style="margin:0">Payments</h5>
              <p style="margin:6px 0 0; color:var(--muted)">Rent due within the first week of each month. Late fees may apply.</p>
            </div>
          </div>
        </div>

        <div class="rule-card" data-rule="clean">
          <div style="display:flex; gap:12px; align-items:center">
            <div class="rule-icon"><i class="bi bi-bucket"></i></div>
            <div>
              <h5 style="margin:0">Cleanliness</h5>
              <p style="margin:6px 0 0; color:var(--muted)">Keep your room and common areas tidy. Dispose trash properly.</p>
            </div>
          </div>
        </div>

        <div class="rule-card" data-rule="maintenance">
          <div style="display:flex; gap:12px; align-items:center">
            <div class="rule-icon"><i class="bi bi-tools"></i></div>
            <div>
              <h5 style="margin:0">Maintenance</h5>
              <p style="margin:6px 0 0; color:var(--muted)">Report issues immediately to management for repair.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT / INQUIRY -->
  <section id="contact" data-aos="fade-up" style="background:transparent">
    <div class="container container-lg">
      <div class="section-title">Contact & Inquiry</div>

      <div class="row g-4 justify-content-center">
        <div class="col-lg-6">
          <div class="contact-box">
            <h5>Send an Inquiry</h5>
            <p style="color:var(--muted)">Fill the form — admin will get back to you.</p>
            <!-- Replace action with your backend route -->
            <form id="inquiryForm" method="POST" action="/send-inquiry">
              <input type="hidden" name="preferred_room" id="preferred_room" value="">
              <div class="mb-3"><input name="name" type="text" class="form-control" placeholder="Your full name" required></div>
              <div class="mb-3"><input name="email" type="email" class="form-control" placeholder="Your email" required></div>
              <div class="mb-3"><input name="phone" type="text" class="form-control" placeholder="Phone (optional)"></div>
              <div class="mb-3"><textarea name="message" class="form-control" rows="4" placeholder="Message or inquiry..." required></textarea></div>
              <button class="btn btn-cta w-100" type="submit">Send Inquiry</button>
            </form>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="contact-box">
            <h5>Contact Info</h5>
            <p style="color:var(--muted)">📍 Barangay XYZ, Sorsogon City</p>
            <p style="color:var(--muted)">📞 0912-345-6789</p>
            <p style="color:var(--muted)">✉️ goyal@gmail.com</p>
            <p style="color:var(--muted)">🕒 Mon–Sat, 8:00 AM – 6:00 PM</p>
            <hr>
            <small style="color:#aaa">You can also pay rent via GCash.</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="container container-lg">
      <div style="display:flex; justify-content:center; gap:10px; align-items:center; color:#ddd; flex-wrap:wrap">
        <div>© <%= new Date().getFullYear() %> Goyal Boarding House</div>
        <div>•</div>
        <div><a href="#" style="color:var(--gold-2); text-decoration:none">Privacy</a></div>
        <div>•</div>
        <div><a href="#" style="color:var(--gold-2); text-decoration:none">Terms</a></div>
      </div>
    </div>
  </footer>

  <!-- GCash QR Modal -->
  <div class="modal fade" id="gcashModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="border-radius:14px; overflow:hidden;">
        <div class="modal-body text-center p-4">
          <h5>Pay via QR Code</h5>
<p class="text-muted">Use any bank app or e-wallet. Just scan the QR code to complete your payment safely and easily.</p>
          <!-- Replace gcash-qr.jpg with your QR image -->
          <img id="gcashQr" src="qr.jpg" alt="GCash QR" style="max-width:320px; width:100%; border-radius:12px; box-shadow:0 20px 40px rgba(0,0,0,0.15)">
          <div style="margin-top:16px">
            <button class="btn btn-cta" data-bs-dismiss="modal">Done</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SCRIPTS: Bootstrap, AOS, GSAP -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.0/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.0/ScrollTrigger.min.js"></script>

  <script>
    // INIT AOS
    AOS.init({
      duration: 800,
      once: true,
      offset: 80
    });

    // navbar scroll effect
    const navbar = document.querySelector('.navbar');
    const onScroll = () => navbar.classList.toggle('scrolled', window.scrollY > 30);
    window.addEventListener('scroll', onScroll);
    onScroll();

    // reveal sections (fallback for non-AOS / ensure show class)
    const sections = document.querySelectorAll('section');
    const revealOnScroll = () => {
      sections.forEach(s => {
        const rect = s.getBoundingClientRect();
        if (rect.top < window.innerHeight - 80) s.classList.add('show');
      });
    };
    window.addEventListener('scroll', revealOnScroll);
    revealOnScroll();

    // GSAP: pulse animation for GCash card and stagger-in for rules
    gsap.registerPlugin(ScrollTrigger);

    // pulse GCash CTA once in view
    gsap.fromTo("#gcash .gcash-card", { scale: 0.98, opacity: 0.9 }, {
      scale: 1, opacity: 1, duration: 1.2, ease: "power2.out",
      scrollTrigger: { trigger: "#gcash", start: "top 70%" }
    });
    // subtle floating of gcash-logo
    gsap.to("#gcash .gcash-logo", { y: -8, repeat: -1, yoyo: true, duration: 3, ease: "sine.inOut" });

    // stagger-in rule cards
    gsap.from("#rulesGrid .rule-card", {
      y: 30, opacity: 0, duration: .75, stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: { trigger: "#rules", start: "top 75%" }
    });

    // room cards 3D tilt on mouse move (small tilt)
    document.querySelectorAll('.room-card').forEach(card=>{
      card.addEventListener('mousemove', (e)=>{
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const cx = rect.width/2, cy = rect.height/2;
        const dx = (x - cx) / cx; // -1 .. 1
        const dy = (y - cy) / cy;
        card.style.transform = `perspective(900px) rotateX(${(-dy*4).toFixed(2)}deg) rotateY(${(dx*5).toFixed(2)}deg) translateY(-6px)`;
      });
      card.addEventListener('mouseleave', ()=>{ card.style.transform = ''; });
    });

    // show QR modal
    document.getElementById('showQrBtn').addEventListener('click', ()=>{
      const modal = new bootstrap.Modal(document.getElementById('gcashModal'));
      modal.show();
    });

    // small GSAP animation for hero cta entrance
    gsap.from(".hero .btn-cta", { y: 14, opacity: 0, duration: .9, delay: .6, ease: "power3.out" });

    // prefill inquiry when clicking Book Now
    function prefillInquiry(roomName){
      const el = document.getElementById('preferred_room');
      if(el) el.value = roomName;
      // scroll to inquiry smoothly
      document.querySelector('#contact').scrollIntoView({ behavior:'smooth', block:'center' });
      // add a tiny highlight
      const box = document.querySelector('#inquiryForm') || document.querySelector('#contact .contact-box');
      if(box){
        gsap.fromTo(box, { boxShadow: "0 0 0 rgba(0,0,0,0)" }, { boxShadow: "0 10px 40px rgba(212,175,55,0.15)", duration:.6, yoyo:true, repeat:1 });
      }
    }

    // Accessibility: trap focus inside modal when open (Bootstrap handles but this ensures focus)
    document.getElementById('gcashModal').addEventListener('shown.bs.modal', ()=>{ document.getElementById('gcashQr').focus(); });

  </script>
  <script>
  // Fix iOS Safari viewport height bug on hero section
  function adjustHeroHeight() {
    document.querySelectorAll('.hero').forEach(h => {
      h.style.height = window.innerHeight + 'px';
    });
  }
  window.addEventListener('resize', adjustHeroHeight);
  window.addEventListener('orientationchange', adjustHeroHeight);
  adjustHeroHeight();
</script>

</body>
</html>
