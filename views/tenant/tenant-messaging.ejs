<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>GOYAL BOARDING HOUSE</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #f4f6fb;
      color: #212529;
      margin: 0;
      min-height: 100vh;
    }

     .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: #fff;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      padding: 0.75rem 1.5rem;
      z-index: 1100;
    }

     .desktop-sidebar {
      position: fixed;
      top: 60px;
      left: 0;
      width: 240px;
      height: calc(100vh - 60px);
      background: linear-gradient(#000f06, #3d3f39b7, #0f1113d7);
      padding: 2.5rem 1.25rem;
      color: #fff;
      box-shadow: 2px 0 15px rgba(0,0,0,0.25);
      border-radius: 0 1rem 1rem 0;
      transition: transform 0.3s ease;
      overflow-y: auto;
      z-index: 1050;
    }

    @media (max-width: 991.98px) {
      .desktop-sidebar {
        transform: translateX(-100%);
      }
      .desktop-sidebar.open {
        transform: translateX(0);
      }
    }

    @media (min-width: 992px) {
      body { margin-left: 240px; }
      .main-content { margin-left: 240px; } 
    }

    .desktop-sidebar .nav-link {
      color: #fff;
      padding: 0.65rem 1rem;
      border-radius: 0.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      transition: background-color 0.3s ease;
    }

    .desktop-sidebar .nav-link.active,
    .desktop-sidebar .nav-link:hover {
      background-color: #ffd700;
      color: #0d2b45 !important;
      box-shadow: 0 0 10px rgba(255,193,7,0.6);
      font-weight: 600;
    }

    .tenant-avatar {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      border: 4px solid #d4c28e;
      object-fit: cover;
    }

     .main-content {
      padding: 2.5rem 2rem;
      padding-top: 6rem;
      background: #fff;
      min-height: 100vh;
    }
 #toggleSidebarDesktop i {
  color: #2b2b2b;  
  transition: color 0.3s ease;
}

#toggleSidebarDesktop:hover i {
  color: #000;  
}

    .card {
      border-radius: 1rem;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
      border: none;
    }

    .card-header {
      background-color: #d4c28e;
      color: #0d2b45;
      font-weight: 700;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border-radius: 1rem 1rem 0 0;
    }

     .chat-box {
      flex-grow: 1;
      overflow-y: auto;
      padding: 1.25rem;
      background-color: #f8f9fa;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      scroll-behavior: smooth;
      border-radius: 0 0 1rem 1rem;
    }

    .message {
      padding: 0.75rem 1rem;
      border-radius: 1rem;
      max-width: 70%;
      font-size: 0.9rem;
      word-wrap: break-word;
      position: relative;
    }

    .message small {
      display: block;
      font-size: 0.75rem;
      opacity: 0.7;
      margin-top: 0.25rem;
    }

    .sent {
      background-color: #0d2b45;
      color: #fff;
      align-self: flex-end;
      border-bottom-right-radius: 0.25rem;
      box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
    }

    .received {
      background-color: #fff;
      color: #212529;
      align-self: flex-start;
      border-bottom-left-radius: 0.25rem;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .chat-input {
      display: flex;
      gap: 0.5rem;
      border-top: 1px solid #ddd;
      padding: 0.75rem;
    }

    .chat-input input {
      flex: 1;
      border-radius: 25px;
      border: 1px solid #ccc;
      padding: 0.5rem 1rem;
      outline: none;
    }

    .chat-input button {
      background-color: #d4c28e;
      color: #0d2b45;
      border: none;
      border-radius: 25px;
      padding: 0.5rem 1rem;
      font-weight: 600;
    }

    .chat-input button:hover {
      background-color: #c9b67f;
    }

    @media (max-width: 575.98px) {
      .desktop-sidebar {
        width: 200px;
      }
      body {
        margin-left: 0;
      }
    }

     .desktop-sidebar::-webkit-scrollbar {
      width: 8px;
    }
    .desktop-sidebar::-webkit-scrollbar-track {
      background: transparent;
    }
    .desktop-sidebar::-webkit-scrollbar-thumb {
      background-color: rgba(255, 193, 7, 0.5);
      border-radius: 4px;
    }

    .desktop-sidebar .nav-link:focus-visible {
      outline: 3px solid #ffc107;
      outline-offset: 2px;
      background-color: #ffc107;
      color: #0d2b45 !important;
    }
  </style>
</head>

<body>

   <nav class="navbar navbar-expand-lg">
    <div class="container-fluid d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <button id="toggleSidebarDesktop" class="btn btn-outline-light me-2 d-lg-none p-1" aria-label="Toggle sidebar">
          <i class="bi bi-list fs-5"></i>
        </button>
        <a class="navbar-brand d-flex align-items-center gap-1 fs-6" href="#">
          <i class="bi bi-house-door-fill fs-6"></i>
          <span>Tenant Portal</span>
        </a>
      </div>

      <div class="d-flex align-items-center gap-2">
        <a href="/tenant/logout" class="btn btn-white-custom btn-sm fw-semibold py-1 px-2 d-flex align-items-center" aria-label="Logout">
          <i class="bi bi-box-arrow-right me-1 fs-6"></i> Logout
        </a>
      </div>
    </div>
  </nav>

   <aside class="desktop-sidebar" id="desktopSidebar" role="navigation" aria-label="Sidebar menu">
    <div class="text-center mb-4">
      <% if (tenant.avatar_url) { %>
        <img src="/uploads/<%= tenant.avatar_url %>" alt="Tenant Avatar" class="tenant-avatar" />
      <% } else { %>
        <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="Tenant Avatar" class="tenant-avatar" />
      <% } %>
      <h6 class="fw-bold"><%= tenant.first_name %></h6>
      <p><strong>User ID:</strong> <%= tenant.id || 'N/A' %></p>
    </div>

    <nav class="nav flex-column">
      <a class="nav-link" href="/dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
      <a class="nav-link" href="/tenant/profile"><i class="bi bi-person-circle"></i> Profile</a>
      <a class="nav-link" href="/tenant/history"><i class="bi bi-clock-history"></i> Rent History</a>
      <a class="nav-link" href="/tenant/report-issue"><i class="bi bi-tools"></i> Maintenance</a>
      <a class="nav-link" href="/tenant/move-out"><i class="bi bi-box-arrow-up"></i> Move Out</a>
      <a class="nav-link" href="/tenant/notification"><i class="bi bi-bell"></i> Notification</a>
      <a class="nav-link active" href="/tenant/messaging"><i class="bi bi-chat-dots"></i> Messaging</a>
    </nav>
  </aside>

   <main class="main-content">
    <div class="card shadow-sm border-0">
      <div class="card-header">
        <i class="bi bi-chat-dots"></i> ADMIN
      </div>

      <div class="card-body p-0 d-flex flex-column" style="height: 75vh;">
         <div class="chat-box flex-grow-1" id="chatBox">
          <div class="text-center text-muted mt-5">
            <i class="bi bi-chat-dots fs-2 mb-2 d-block"></i>
            <p>No messages yet. Start a conversation below!</p>
          </div>
        </div>

         <div class="chat-input border-top bg-light p-3">
          <div class="input-group">
            <input type="text" id="msgInput" class="form-control rounded-pill" placeholder="Type a message..." aria-label="Type message" />
            <button id="sendBtn" class="btn rounded-pill ms-2" style="background-color:#d4c28e; color:#0d2b45; font-weight:600;" aria-label="Send">
              <i class="bi bi-send-fill"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="/socket.io/socket.io.js"></script>
<script>
const socket = io();
const tenantId = "<%= user.id %>"; 
const chatBox = document.getElementById('chatBox');
const input = document.getElementById('msgInput');
const sendBtn = document.getElementById('sendBtn');

 socket.emit('register', { userId: tenantId, role: 'tenant' });

 function appendMessage(message, senderRole, createdAt) {
  chatBox.innerHTML += `
    <div class="message ${senderRole === 'tenant' ? 'sent' : 'received'}">
      <div>${message}</div>
      <small class="text-muted" style="font-size:10px;">${new Date(createdAt).toLocaleString()}</small>
    </div>`;
  chatBox.scrollTop = chatBox.scrollHeight;
}

 async function loadChatHistory() {
  try {
    const res = await fetch('/tenant/chat-history');
    const messages = await res.json();
    messages.forEach(msg => appendMessage(msg.message, msg.sender_role, msg.created_at));
  } catch (err) {
    console.error('Error loading chat history:', err);
  }
}

 loadChatHistory();

 socket.on('receiveMessage', (data) => {
  appendMessage(data.message, data.senderRole, data.createdAt);
});

 sendBtn.addEventListener('click', () => {
  const message = input.value.trim();
  if (!message) return;

  socket.emit('sendMessage', {
    senderId: tenantId,
    receiverId: 0,  
    message,
    senderRole: 'tenant'
  });

  appendMessage(message, 'tenant', new Date());
  input.value = '';
});
</script>


  <script>
    const toggleSidebarBtn = document.getElementById('toggleSidebarDesktop');
    const desktopSidebar = document.getElementById('desktopSidebar');
    toggleSidebarBtn.addEventListener('click', () => {
      desktopSidebar.classList.toggle('open');
    });
  </script>

</body>
</html>
