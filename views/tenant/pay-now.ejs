<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background: #f0f2f5;
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .receipt-container {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.12);
      width: 100%;
      max-width: 550px;
      padding: 25px 30px;
      box-sizing: border-box;
    }

    .receipt-header { text-align: center; margin-bottom: 25px; }
    .receipt-header h2 { font-weight: 600; color: #1a237e; margin-bottom: 8px; font-size: 2rem; }
    .receipt-header p { color: #555; font-size: 1rem; margin: 0; }

    .transaction-id { font-family: monospace; color: #666; font-size: 0.95rem; text-align: center; margin-bottom: 20px; letter-spacing: 1px; user-select: text; }
    .receipt-info { font-size: 1rem; margin-bottom: 25px; color: #444; }
    .receipt-row { display: flex; justify-content: space-between; margin-bottom: 12px; }
    .receipt-row strong { color: #212529; font-weight: 600; }

    .receipt-amount { font-size: 2.5rem; font-weight: 700; color: #2e7d32; margin-bottom: 30px; text-align: center; letter-spacing: 1px; }

    .btn-pay {
      background-color: #3f51b5;
      color: white;
      font-weight: 600;
      width: 100%;
      padding: 14px 0;
      border-radius: 10px;
      border: none;
      font-size: 1rem;
      cursor: pointer;
      transition: background-color 0.3s ease, transform 0.2s ease;
      text-align: center;
      text-decoration: none;
      display: inline-block;
    }

    .btn-pay:hover,
    .btn-pay:focus { background-color: #283593; transform: scale(1.04); color: white; }
    .btn-pay + .btn-pay { margin-top: 12px; }

    .powered-by { text-align: center; font-size: 0.9rem; color: #888; margin-top: 30px; user-select: none; }

    @media (max-width: 768px) {
      .receipt-container { padding: 18px 15px; max-width: 95%; }
      .receipt-header h2 { font-size: 1.4rem; }
      .transaction-id { font-size: 0.8rem; }
      .receipt-amount { font-size: 1.8rem; }
    }
  </style>
</head>
<body>
    <div class="receipt-container">
    <div class="receipt-header">
      <h2>Pay Rent</h2>
      <p>Pay Your Rent Quickly & Securely</p>
    </div>

    <div class="transaction-id">
      Invoice: <%= transactionId %>
    </div>

    <div class="receipt-info">
      <div class="receipt-row">
        <div>Amount Due</div>
        <div><strong>₱<%= Number(amount).toLocaleString() %></strong></div>
      </div>
      <div class="receipt-row">
        <div>Due Date</div>
        <div><strong><%= tenant.next_due_date instanceof Date && !isNaN(tenant.next_due_date) ? new Date(tenant.next_due_date).toLocaleDateString() : 'N/A' %></strong></div>
      </div>
      <div class="receipt-row">
        <div>Payment Date</div>
        <div><strong><%= paymentDate %></strong></div>
      </div>
    </div>

    <div class="receipt-amount">
      ₱<%= Number(amount).toLocaleString() %>
    </div>
<% if (tenant.payment_status !== 'Paid') { %>
  <form action="/tenant/pay-now/process" method="POST">
    <input type="hidden" name="amount" value="<%= amount %>">
    <input type="hidden" name="method" value="GCASH">
    <input type="hidden" name="month" value="<%= tenant.next_due_month %>">
    <div class="mb-3">
      <label for="method" class="form-label">Select Payment Method</label>
      <select name="method" id="method" class="form-select" required>
        <option value="GCASH">GCash</option>
      </select>
    </div>
    <button type="submit" class="btn-pay" onclick="this.disabled=true; this.form.submit();">Pay Now</button>
  </form>
<% } else { %>
  <button class="btn-pay" disabled>Already Paid for This Month</button>
<% } %>


    <a href="/dashboard" class="btn-pay" style="background-color: #e0e0e0; color: #333; margin-top: 12px;">
      Cancel
    </a>

    <div class="powered-by">
      Powered by CGBH
    </div>
  </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>