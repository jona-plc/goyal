  <script>
     AOS.init({
      duration: 800,
      once: true,
      offset: 80
    });

     const navbar = document.querySelector('.navbar');
    const onScroll = () => navbar.classList.toggle('scrolled', window.scrollY > 30);
    window.addEventListener('scroll', onScroll);
    onScroll();

     const sections = document.querySelectorAll('section');
    const revealOnScroll = () => {
      sections.forEach(s => {
        const rect = s.getBoundingClientRect();
        if (rect.top < window.innerHeight - 80) s.classList.add('show');
      });
    };
    window.addEventListener('scroll', revealOnScroll);
    revealOnScroll();

     gsap.registerPlugin(ScrollTrigger);

     gsap.fromTo("#gcash .gcash-card", { scale: 0.98, opacity: 0.9 }, {
      scale: 1, opacity: 1, duration: 1.2, ease: "power2.out",
      scrollTrigger: { trigger: "#gcash", start: "top 70%" }
    });
     gsap.to("#gcash .gcash-logo", { y: -8, repeat: -1, yoyo: true, duration: 3, ease: "sine.inOut" });

     gsap.from("#rulesGrid .rule-card", {
      y: 30, opacity: 0, duration: .75, stagger: 0.12,
      ease: "power3.out",
      scrollTrigger: { trigger: "#rules", start: "top 75%" }
    });

     document.querySelectorAll('.room-card').forEach(card=>{
      card.addEventListener('mousemove', (e)=>{
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const cx = rect.width/2, cy = rect.height/2;
        const dx = (x - cx) / cx; // -1 .. 1
        const dy = (y - cy) / cy;
        card.style.transform = `perspective(900px) rotateX(${(-dy*4).toFixed(2)}deg) rotateY(${(dx*5).toFixed(2)}deg) translateY(-6px)`;
      });
      card.addEventListener('mouseleave', ()=>{ card.style.transform = ''; });
    });

     document.getElementById('showQrBtn').addEventListener('click', ()=>{
      const modal = new bootstrap.Modal(document.getElementById('gcashModal'));
      modal.show();
    });

     gsap.from(".hero .btn-cta", { y: 14, opacity: 0, duration: .9, delay: .6, ease: "power3.out" });

    function prefillInquiry(roomName){
