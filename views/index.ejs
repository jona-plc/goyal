  });
document.addEventListener('DOMContentLoaded', () => {
  const modalEl = document.getElementById('gcashModal');

  modalEl.addEventListener('shown.bs.modal', () => {
    document.body.style.overflow = 'hidden';
  });

  modalEl.addEventListener('hidden.bs.modal', () => {
     document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
    document.body.classList.remove('modal-open');
    document.body.style.overflow = 'auto';
    document.body.style.paddingRight = '0';
    document.documentElement.style.overflow = 'auto';
setTimeout(() => {
  adjustHeroHeight();
  document.body.style.transform = 'none';
 }, 100);

  });
});
</script>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script type="text/javascript" src="https://cdn.emailjs.com/dist/email.min.js"></script>

<script type="text/javascript">
  emailjs.init('PITdy_zRPM4EUUbQs');

  const inquiryForm = document.getElementById('inquiryForm');
  const feedbackModalEl = document.getElementById('feedbackModal');
  const feedbackMessageEl = document.getElementById('feedbackMessage');
  const feedbackModal = new bootstrap.Modal(feedbackModalEl);

  inquiryForm.addEventListener('submit', function(e) {
    e.preventDefault();

    const submitBtn = this.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.innerText = 'Sending...';

    emailjs.sendForm('service_14y3hqj', 'template_k0c2e5p', this)
      .then(() => {
        feedbackMessageEl.innerText = 'Your inquiry has been sent successfully!';
        feedbackModal.show();
        this.reset();
      })
      .catch((error) => {
        feedbackMessageEl.innerText = 'Failed to send inquiry. Please try again.';
        feedbackModal.show();
        console.error('EmailJS error:', error);
      })
      .finally(() => {
        submitBtn.disabled = false;
        submitBtn.innerText = 'Send Inquiry';
      });
  });

  feedbackModalEl.addEventListener('hidden.bs.modal', () => {
    inquiryForm.querySelector('button[type="submit"]').innerText = 'Send Inquiry';
  });
</script>
</body>
</html>
