<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>GOYAL BOARDING HOUSE</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
  <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet">

<style>
:root {
  --gold: #d4af37;
  --gold-2: #ffd700;
  --bg: #fdfbf6;
  --muted: #556;
  --accent-blue: #0a6ef0;
}

html, body {
  width: 100%;
  overflow-x: hidden !important;
  margin: 0;
  padding: 0;
}
* {
  box-sizing: border-box;
  max-width: 100%;
}
body {
  font-family: 'Poppins', sans-serif;
  background: var(--bg);
  color: #232323;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.navbar {
  background: rgba(0,0,0,0.6);
  transition: all .35s ease;
  backdrop-filter: blur(6px);
  width: 100%;
  overflow-x: hidden;
}
.navbar.scrolled {
  background:#000;
  box-shadow:0 6px 24px rgba(0,0,0,0.35);
}
.navbar-brand {
  color:var(--gold-2) !important;
  font-weight:700;
  letter-spacing:.6px;
}
.nav-link {
  color:#fff !important;
  font-weight:500;
}
.nav-link:hover {
  color:var(--gold-2) !important;
  transform:translateY(-1px);
}
 
button, .btn-login, .btn-ghost, .btn-qr {
  font-family: 'Poppins', sans-serif;
  font-weight:700;
  cursor:pointer;
  transition: all 0.3s ease;
  text-align:center;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  justify-content:center;
}
button i, .btn-login i, .btn-cta i, .btn-ghost i, .btn-qr i {
  margin-right:6px;
  font-size:1.1rem;
  transition: transform 0.3s;
}
.btn-cta {
  background-color: #FFD700;  
  color: #000; 
  border-radius: 30px;
  padding: .75rem 1.5rem;
  font-size: 1rem;
  border: none;
  box-shadow: 0 8px 30px rgba(212,175,55,0.18);
}
.btn-cta:hover {
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 12px 36px rgba(212,175,55,0.25);
}

 .btn-login, .btn-cta {
  background: linear-gradient(45deg, var(--gold), var(--gold-2));
  color: #000;
  border-radius:30px;
  padding:.75rem 1.5rem;
  font-size:1rem;
  box-shadow:0 8px 30px rgba(212,175,55,0.18);
  border:none;
}
.btn-login:hover, .btn-cta:hover {
  transform: translateY(-3px) scale(1.03);
  box-shadow:0 12px 36px rgba(212,175,55,0.25);
}
.btn-login:hover i, .btn-cta:hover i {
  transform: translateY(-2px);
}

.btn-ghost {
  background:transparent;
  border:2px solid rgba(255,255,255,0.22);
  color:#fff;
  padding:.65rem 1.3rem;
  border-radius:28px;
  font-size:0.95rem;
}
.btn-ghost:hover {
  background: rgba(255,255,255,0.1);
  transform: translateY(-2px);
  border-color: var(--gold-2);
}
.btn-ghost:hover i {
  transform: translateY(-2px);
}

.btn-qr {
  background: rgba(255,255,255,0.95);
  color:#012;
  border-radius:12px;
  padding:.65rem 1rem;
  font-weight:700;
  font-size:0.95rem;
  min-width:120px;
  text-align:center;
  box-shadow:0 6px 18px rgba(0,0,0,0.12);
}
.btn-qr:hover {
  background:#fff;
  transform: translateY(-2px);
  box-shadow:0 10px 24px rgba(0,0,0,0.15);
}
.btn-qr:hover i {
  transform: translateY(-2px);
}

.hero {
  height: 100vh;
  min-height: 720px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  text-align: center;
  color: #fff;
  background-image: url('goyal-bh.jpg');
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  filter: saturate(0.95);
  overflow: hidden;
}
.hero::before {
  content:"";
  position:absolute;
  inset:0;
  background: linear-gradient(180deg, rgba(0,0,0,0.55), rgba(0,0,0,0.7));
  z-index:1;
}
.hero .hero-inner {
  position:relative; z-index:2; max-width:1100px; padding:20px;
}
.hero h1 {
  font-size: clamp(2rem, 4vw, 3.4rem);
  margin-bottom:.6rem;
  font-weight:800;
  line-height:1.02;
  background: linear-gradient(90deg, #cfa800, #ffd700, #fff1b2);
  -webkit-background-clip:text; background-clip:text;
  color:transparent;
  text-transform:none;
  filter: drop-shadow(0 6px 18px rgba(0,0,0,0.35));
}
.hero p {
  font-size:1.05rem; color:#f7f7f7;
  max-width:820px; margin:0 auto 1.25rem; opacity:.95;
}
.hero .cta {
  display:inline-flex; gap:.7rem; align-items:center;
}

.hero .ribbon {
  position:absolute; right:-8%; top:10%;
  width:260px; height:260px; opacity:.08;
  filter:blur(18px);
  background:radial-gradient(circle at 30% 30%, rgba(255,230,128,1), rgba(255,230,128,0.2) 30%, transparent 60%);
  transform:rotate(-20deg);
  z-index:0;
  animation:ribbonFloat 6s ease-in-out infinite;
}
@keyframes ribbonFloat {
  0% { transform: translateY(0) rotate(-18deg) }
  50% { transform: translateY(-20px) rotate(-24deg) }
  100% { transform: translateY(0) rotate(-18deg) }
}

section { padding: clamp(60px,7vw,110px) 20px; opacity:0; transform:translateY(30px); transition: all .9s cubic-bezier(.2,.9,.2,1); }
section.show { opacity:1; transform:translateY(0) }

.container-lg { max-width:1140px; margin:0 auto }

.section-title {
  text-align:center; color:var(--gold);
  font-weight:700; font-size:1.7rem; margin-bottom:1rem;
}

.about-grid { display:grid; grid-template-columns:1fr 1fr; gap:36px; align-items:center; }
.about-img { border-radius:14px; overflow:hidden; box-shadow:0 18px 40px rgba(12,12,12,0.14); }
.about-img img { width:100%; height:100%; object-fit:cover; min-height:320px; display:block; transition:transform .6s ease; }
.about-card { padding:24px; background:#fff; border-radius:14px; box-shadow:0 10px 30px rgba(0,0,0,0.05); }
.about-highlights { display:flex; gap:14px; flex-wrap:wrap; margin-top:16px; }
.about-chip { display:flex; gap:10px; align-items:center; background:linear-gradient(180deg,#fff,#fffaf0); border-radius:12px; padding:10px 12px; box-shadow:0 6px 18px rgba(0,0,0,0.04); }
.about-chip i { color:var(--gold); font-size:1.3rem; }

.rooms-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:22px; }
.room-card { background:#fff; border-radius:14px; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.06); transition: transform .32s ease, box-shadow .32s ease; }
.room-media { height:200px; overflow:hidden; }
.room-media img { width:100%; height:100%; object-fit:cover; transition:transform .5s ease; }
.room-body { padding:18px; }
.room-title { font-weight:700; color:#222; }
.room-price { margin-top:8px; font-weight:700; color:var(--accent-blue); }
.room-card:hover { transform:translateY(-10px); box-shadow:0 18px 50px rgba(0,0,0,0.12); }
.room-card:hover .room-media img { transform:scale(1.06); }

.rules-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px; }
.rule-card { background:linear-gradient(180deg,#fff,#fffdf5); border-radius:12px; padding:18px; box-shadow:0 12px 30px rgba(0,0,0,0.06); border-left:6px solid var(--gold); transition:transform .35s ease, box-shadow .35s ease; }
.rule-card:hover { transform:translateY(-8px); box-shadow:0 20px 50px rgba(0,0,0,0.12); }
.rule-icon { width:56px; height:56px; border-radius:12px; display:inline-grid; place-items:center; background:linear-gradient(135deg,rgba(212,175,55,0.14),rgba(255,215,0,0.06)); font-size:1.4rem; color:var(--gold); }

#gcash {
  background:linear-gradient(135deg,#062b5f 0%, #0a52d8 45%, #0a6ef0 100%);
  color:#fff; border-radius:14px; padding:40px; position:relative;
  box-shadow:0 18px 60px rgba(10,110,240,0.12);
  overflow:hidden;
}
#gcash .gcash-inner { display:flex; gap:30px; align-items:center; justify-content:center; flex-wrap:wrap; }
.gcash-card { display:flex; gap:18px; align-items:center; background:rgba(255,255,255,0.06); padding:20px; border-radius:12px; min-width:320px; box-shadow:inset 0 1px 0 rgba(255,255,255,0.02); }
.gcash-logo { width:120px; height:120px; display:grid; place-items:center; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 12px 30px rgba(0,0,0,0.12); }
.gcash-logo img { max-width:80%; }
.gcash-cta { display:flex; flex-direction:column; gap:10px; align-items:flex-start; }

.contact-box { background:#fff; padding:26px; border-radius:14px; box-shadow:0 12px 40px rgba(0,0,0,0.06); text-align:center; }
footer { padding:26px; text-align:center; color:#ddd; background:#000; margin-top:8px; }

.term-card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 20px 40px rgba(0,0,0,0.1);
}
.term-card p { line-height:1.6; }
.term-icon { transition: transform 0.3s; }
.term-card:hover .term-icon { transform: rotate(10deg) scale(1.1); }
.rooms-swiper {
  padding: 20px 0;
}

.swiper-slide {
  display: flex;
  justify-content: center;
  align-items: center;
}

.room-img {
  width: 100%;
  height: auto;
  max-height: 400px;
  object-fit: cover;
  border-radius: 14px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  transition: transform 0.3s ease;
}

.room-img:hover {
  transform: scale(1.05);
}

.swiper-button-next,
.swiper-button-prev {
  color: var(--gold-2);
}

.swiper-pagination-bullet {
  background: var(--gold-2);
}
.btn-cta {
  background-color: #FFD700;  
  color: #000;  
  border-radius: 30px;
  padding: .75rem 1.5rem;
  font-size: 1rem;
  border: none;
  box-shadow: 0 8px 30px rgba(212,175,55,0.18);
}
.btn-cta:hover {
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 12px 36px rgba(212,175,55,0.25);
}

 @media (max-width:900px) {
  .about-grid { grid-template-columns:1fr; gap:20px; }
  .hero { min-height:680px; }
}
@media (max-width:768px) {
  .navbar-nav {
    text-align:center;
    background:rgba(0,0,0,0.85);
    border-radius:10px;
    padding:10px 0;
  }
  .hero { height:auto; min-height:500px; padding:80px 20px; }
  .hero h1 { font-size:1.9rem; }
  .hero p { font-size:0.95rem; }
  .cta { flex-direction:column; gap:10px; }
  .about-grid { grid-template-columns:1fr; gap:20px; }
  .gcash-inner { flex-direction:column; text-align:center; }
  .gcash-card { width:100%; min-width:auto; }
  .gcash-logo { width:100px; height:100px; }
  .rules-grid { grid-template-columns:1fr; }
  .contact-box { padding:20px; }
  footer { font-size:0.9rem; }
}
@media (max-width:480px) {
  .hero h1 { font-size:1.6rem; }
  .btn-cta, .btn-ghost, .btn-login, .btn-qr { padding:0.5rem 1rem; font-size:0.9rem; }
  .room-card { font-size:0.9rem; }
}
.modal-open {
  padding-right: 0 !important;
}
.navbar.bg-white .nav-link {
  color: #000 !important; 
}
.navbar.bg-white .navbar-brand {
  color: #000 !important; 
}
@media (max-width: 768px) {
  .navbar-nav {
    background: transparent !important; 
    box-shadow: none !important; 
    padding: 0; 
  }
}


</style>

</head>
<body>
 
<nav class="navbar navbar-expand-lg navbar-light bg-white fixed-top">
  <div class="container container-lg">
    <a class="navbar-brand text-dark" href="#">GBH</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <li class="nav-item"><a class="nav-link text-dark" href="#about">About</a></li>
        <li class="nav-item"><a class="nav-link text-dark" href="#rooms">Rooms</a></li>
        <li class="nav-item"><a class="nav-link text-dark" href="#gcash">Payments</a></li>
        <li class="nav-item"><a class="nav-link text-dark" href="#contact">Contact</a></li>
        <li class="nav-item ms-3">
          <a class="btn btn-login text-dark" href="/login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Login
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>


 
  <header class="hero" id="home">
    <div class="ribbon" aria-hidden="true"></div>
    <div class="hero-inner" data-aos="zoom-in" data-aos-delay="120">
      <h1>Welcome to Goyal Boarding House</h1>
      <p>Comfortable, secure, and affordable living for students and professionals in Zone 8 Bulan Sorsogon City.</p>

      <div class="cta">
        <a class="btn btn-cta me-2" href="#contact">Inquire Now</a>
        <a class="btn btn-ghost" href="#rooms">View Rooms</a>
      </div>
    </div>
  </header>
 
  <section id="about" class="bg-section" data-aos="fade-up">
    <div class="container container-lg">
      <div class="section-title">About Us</div>

      <div class="about-grid">
        <div class="about-img" data-aos="fade-right" data-aos-delay="120">
           <img src="goyal-bh.jpg" alt="Goyal Boarding House image">
        </div>

        <div class="about-card" data-aos="fade-left" data-aos-delay="200">
          <h3 style="margin-bottom:.4rem">A Home Away From Home</h3>
         <p style="color:var(--muted); line-height:1.7">
  Goyal Boarding House offers safe, clean, and comfortable living spaces in Zone 8, Bulan, Sorsogon. 
  We provide students and working professionals with affordable rates, well-maintained rooms, secure premises, and fast Wi-Fi.
</p>


          <div class="about-highlights">
            <div class="about-chip"><i class="bi bi-wifi"></i><div><strong>Free Wi-Fi</strong><div style="font-size:.85rem;color:#666">24/7 reliable</div></div></div>
            <div class="about-chip"><i class="bi bi-lock"></i><div><strong>Secure</strong><div style="font-size:.85rem;color:#666">CCTV & gated</div></div></div>
            <div class="about-chip"><i class="bi bi-thermometer-sun"></i><div><strong>Comfort</strong><div style="font-size:.85rem;color:#666">Furnished rooms</div></div></div>
          </div>

          <div style="margin-top:18px">
            <a href="#rooms" class="btn btn-cta">See Rooms</a>
          </div>
        </div>
      </div>
    </div>
  </section>
 <section id="rooms" data-aos="fade-up">
  <div class="container container-lg">
    <div class="section-title">
      <h2>Our Rooms</h2>
    </div>

     <div class="swiper rooms-swiper">
      <div class="swiper-wrapper">
         <div class="swiper-slide">
          <img src="double-room1.jpg" alt="Room 1" class="room-img">
        </div>
        <div class="swiper-slide">
          <img src="double-room2.jpg" alt="Room 2" class="room-img">
        </div>
        <div class="swiper-slide">
          <img src="double-room.jpg" alt="Room 3" class="room-img">
        </div>
        <div class="swiper-slide">
          <img src="pic1.jpg" alt="Room 4" class="room-img">
        </div>
        <div class="swiper-slide">
          <img src="pic2.jpg" alt="Room 5" class="room-img">
        </div>
        <div class="swiper-slide">
          <img src="pic3.jpg" alt="Room 6" class="room-img">
        </div>
        <div class="swiper-slide">
          <img src="pic4.jpg" alt="Room 7" class="room-img">
        </div>
        <div class="swiper-slide">
          <img src="pic5.jpg" alt="Room 8" class="room-img">
        </div>
        <div class="swiper-slide">
          <img src="pic6.jpg" alt="Room 9" class="room-img">
        </div>
      </div>

       <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section> 
<section id="gcash" data-aos="fade-up">
  <div class="container container-lg">
    <div class="section-title text-white">We Accept GCash Payments</div>

    <div class="gcash-inner">
      <div class="gcash-card" data-gsap="pulse">
        <div class="gcash-logo">
          <img src="https://tse1.mm.bing.net/th/id/OIP.6fX2So9vKYRn990uLJ2nhQHaDt?pid=Api&P=0&h=220" alt="GCash Logo">
        </div>

        <div class="gcash-cta">
          <h3 style="color:#fff; margin:0">Pay Easily via GCash</h3>
          <p style="max-width:520px; color:rgba(235,245,255,0.92)">
            Pay your rent instantly and securely. Our system automatically generates a payment link that directs your payment straight to our GCash account. No owner approval needed. Fast, contactless, and hassle-free.
          </p>

          <div style="display:flex; gap:10px;">
            <button class="btn btn-qr" id="showQrBtn"><i class="bi bi-qr-code-scan me-2"></i>Show</button>
            <a class="btn btn-ghost" href="#contact">Need Help?</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


 <section id="rules" data-aos="fade-up">
  <div class="container container-lg">
    <div class="section-title">House Rules & Regulations</div>

    <div class="rules-grid" id="rulesGrid">

       <div class="rule-card" data-rule="quiet">
        <div style="display:flex; gap:12px; align-items:center">
          <div class="rule-icon"><i class="bi bi-moon-stars"></i></div>
          <div>
            <h5 style="margin:0">Quiet Hours</h5>
            <p style="margin:6px 0 0; color:var(--muted)">
              Maintain quiet from <strong>10:00 PM</strong> to <strong>6:00 AM</strong>.
            </p>
          </div>
        </div>
      </div>

       <div class="rule-card" data-rule="visitors">
        <div style="display:flex; gap:12px; align-items:center">
          <div class="rule-icon"><i class="bi bi-people"></i></div>
          <div>
            <h5 style="margin:0">Visitor Policy</h5>
            <p style="margin:6px 0 0; color:var(--muted)">
              Visitors allowed until <strong>9:00 PM</strong>. No overnight stays without approval.
            </p>
          </div>
        </div>
      </div>

      <div class="rule-card" data-rule="no-smoking">
        <div style="display:flex; gap:12px; align-items:center">
          <div class="rule-icon"><i class="bi bi-x-circle"></i></div>
          <div>
            <h5 style="margin:0">No Smoking / No Alcohol</h5>
            <p style="margin:6px 0 0; color:var(--muted)">
              Smoking and alcohol consumption inside premises are strictly prohibited.
            </p>
          </div>
        </div>
      </div>
      <div class="rule-card" data-rule="payments">
        <div style="display:flex; gap:12px; align-items:center">
          <div class="rule-icon"><i class="bi bi-wallet2"></i></div>
          <div>
            <h5 style="margin:0">Payments</h5>
<p style="margin:6px 0 0; color:var(--muted)">
  Rent is due monthly on the same day as your lease start/move-in date. Payments must be made on time each month. 
  <br><br>
  Late payments are not allowed. If rent is not received by the due date, the owner may issue a warning. Repeated late payments may result in termination of the lease and eviction from the property.
</p>

          </div>
        </div>
      </div>

      <div class="rule-card" data-rule="clean">
        <div style="display:flex; gap:12px; align-items:center">
          <div class="rule-icon"><i class="bi bi-bucket"></i></div>
          <div>
            <h5 style="margin:0">Cleanliness</h5>
            <p style="margin:6px 0 0; color:var(--muted)">
              Keep your room and common areas tidy. Dispose trash properly.
            </p>
          </div>
        </div>
      </div>

      <div class="rule-card" data-rule="maintenance">
        <div style="display:flex; gap:12px; align-items:center">
          <div class="rule-icon"><i class="bi bi-tools"></i></div>
          <div>
            <h5 style="margin:0">Maintenance</h5>
            <p style="margin:6px 0 0; color:var(--muted)">
              Report issues immediately to management for repair.
            </p>
          </div>
        </div>
      </div>
      <div class="rule-card" data-rule="security">
        <div style="display:flex; gap:12px; align-items:center">
          <div class="rule-icon"><i class="bi bi-shield-lock"></i></div>
          <div>
            <h5 style="margin:0">Security</h5>
            <p style="margin:6px 0 0; color:var(--muted)">
              Always lock your doors and report suspicious activity to management immediately.
            </p>
          </div>
        </div>
      </div>

      <div class="rule-card" data-rule="fire">
        <div style="display:flex; gap:12px; align-items:center">
          <div class="rule-icon"><i class="bi bi-fire"></i></div>
          <div>
            <h5 style="margin:0">Fire Safety</h5>
            <p style="margin:6px 0 0; color:var(--muted)">
              Do not tamper with smoke detectors or extinguishers. Turn off appliances before leaving.
            </p>
          </div>
        </div>
      </div>

      <div class="rule-card" data-rule="pets">
