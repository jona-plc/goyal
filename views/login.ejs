<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      height: 100%;
      font-family: 'Poppins', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      overflow: hidden;
    }

     body::before {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url("goyal-bh.jpg") no-repeat center center/cover;
      filter: blur(0.5px);
      transform: scale(1.05);
      z-index: -2;
    }

     body::after {
      content: "";
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.6);
      z-index: -1;
    }
    
.login-container {
    background: rgba(55, 55, 55, 0.9);
    border-radius: 18px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    width: 100%;
    max-width: 420px;
    padding: 50px 35px;
    text-align: center;
    position: relative;
    animation: fadeInUp 1.2s 
ease forwards;
}
    @keyframes fadeInUp {
      0% { transform: translateY(50px); opacity: 0; }
      100% { transform: translateY(0); opacity: 1; }
    }

    .login-logo {
      width: 90px;
      margin-bottom: 18px;
      animation: floatLogo 3s ease-in-out infinite;
    }

    @keyframes floatLogo {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
h1 {
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 8px;
  background: linear-gradient(90deg, #cfa800, #ffd700, #ffec8b, #cfa800);
  background-size: 200% auto;
  -webkit-background-clip: text;  
  background-clip: text;          
  -webkit-text-fill-color: transparent;
  color: transparent;            
  animation: shine 3s linear infinite;
}

@keyframes shine {
  to {
    background-position: 200% center;
  }
}


    .tagline {
      font-size: 1rem;
      color: #ffffff;
      margin-bottom: 25px;
      font-style: italic;
    }

    .login-message {
      font-size: 1rem;
      font-weight: 500;
      color: #ffffff;
      margin-bottom: 24px;
    }

    #errorMessage {
      background-color: #e53935;
      color: white;
      padding: 12px;
      border-radius: 8px;
      font-size: 0.9rem;
      margin-bottom: 16px;
      display: none;
      text-align: left;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    label {
      font-weight: 600;
      font-size: 0.95rem;
      color: #ffffff;
      text-align: left;
    }

    input[type="text"],
    input[type="password"] {
      padding: 12px 14px;
      font-size: 1rem;
      border: 2px solid #ddd;
      border-radius: 8px;
      transition: all 0.3s ease;
    }

    input:focus {
      border-color: #ffd700;
      box-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
      outline: none;
    }

    button {
      padding: 14px;
      font-size: 1.05rem;
      font-weight: 600;
      color: #fff;
      background: linear-gradient(45deg, #d4af37, #ffd700, #f9d857);
      border: none;
      border-radius: 30px;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
      transition: all 0.4s ease;
      background-size: 200% auto;
      position: relative;
      overflow: hidden;
    }

    button:hover {
      background-position: right center;
      transform: scale(1.05);
      box-shadow: 0 0 25px rgba(255, 215, 0, 0.8), 0 0 50px rgba(255, 223, 0, 0.4);
    }

    button::after {
      content: "";
      position: absolute;
      top: 0;
      left: -75%;
      width: 50%;
      height: 100%;
      background: linear-gradient(
        120deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.4) 50%,
        rgba(255, 255, 255, 0) 100%
      );
      transform: skewX(-20deg);
      transition: all 0.6s ease;
    }

    button:hover::after {
      left: 125%;
    }

    @media (max-width: 480px) {
      .login-container {
        padding: 30px 20px;
        margin: 0 10px;
      }
      h1 { font-size: 1.5rem; }
    }

      .modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.7);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  flex-direction: column;
  color: white;
  font-size: 1.2rem;
}

.spinner {
  border: 6px solid rgba(255, 255, 255, 0.3);
  border-top: 6px solid #ffd700;
  border-radius: 50%;
  width: 50px;
  height: 50px;
  animation: spin 2s linear infinite;  
  margin-bottom: 15px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}


    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .success-message {
      color: #90ee90;
      font-size: 1.4rem;
      font-weight: bold;
      margin-top: 10px;
    }
  </style>
</head>
<body>
   <div class="modal-overlay" id="loadingModal">
    <div class="spinner"></div>
    <div id="modalText">Logging in...</div>
  </div>

  <div class="login-container">
    <img
      class="login-logo"
      src="https://png.pngtree.com/png-vector/20230112/ourmid/pngtree-houses-logo-png-image_6560047.png"
      alt="Goyal Boarding House Logo"
    />
    <h1>Goyal Boarding House</h1>
    <p class="tagline">Your Comfort, Our Commitment</p>
    <p class="login-message">Please login to your account</p>

    <div id="errorMessage"></div>

    <form id="loginForm">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" required />
      
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required />

      <button type="submit">Login</button>
    </form>
  </div>
<script>
  const errorMessageDiv = document.getElementById('errorMessage');
  const modal = document.getElementById('loadingModal');
  const modalText = document.getElementById('modalText');
  const submitButton = document.querySelector('button[type="submit"]');

  document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMessageDiv.style.display = 'none';
    errorMessageDiv.textContent = '';

    const username = document.getElementById('username').value.trim();
    const password = document.getElementById('password').value.trim();

     submitButton.disabled = true;

    // Show loading modal
    modal.style.display = 'flex';
    modalText.textContent = 'Logging in...';
    modal.querySelector('.spinner').style.display = 'block';

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ username, password })
      });

      const delayDuration = 1000; 

      if (response.redirected) {
         setTimeout(() => {
          modalText.textContent = 'Login successful!';
          modal.querySelector('.spinner').style.display = 'none';

           setTimeout(() => {
            window.location.href = response.url;
          }, 1000);
        }, delayDuration);
      } else {
        const data = await response.json();
        if (data.error) {
          modal.style.display = 'none';
          errorMessageDiv.textContent = data.error;
          errorMessageDiv.style.display = 'block';
          submitButton.disabled = false;  
        }
      }
    } catch {
      modal.style.display = 'none';
      errorMessageDiv.textContent = "Network error. Please try again.";
      errorMessageDiv.style.display = 'block';
      submitButton.disabled = false; 
    }
  });
</script>
</body>
</html>