<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
 body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}

.sidebar a.active {
  background-color: #ffd700;
  color: #000;
  font-weight: 600;
  border-radius: 5px;
}
.sidebar a:hover {
  background-color: rgba(255, 215, 0, 0.3);
  color: #000;
}

.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}
    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }
 
    .main-content {
  position: fixed;
  top: 2px;               
  left: 250px;             
  width: calc(100% - 250px);
  height: calc(100vh - 40px);  
  padding: 30px;
  background-color: inherit;
  z-index: 10;
  box-sizing: border-box;  
  overflow-y: auto;       
}

.card {
  border-radius: 12px;
  transition: box-shadow 0.3s ease;
}

.card:hover {
  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}

.card-title {
  font-size: 1.1rem;
}

    .card-summary {
      text-align: center;
      padding: 15px 15px;
      border-radius: 10px;
      color: #fff;
      margin-bottom: 2px;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .bg-income { background-color: #198754; }
    .bg-expenses { background-color: #dc3545; }
    .bg-net { background-color: #0d6efd; }

    .card-summary i { font-size: 1.20rem; }
    .card-summary h5 { margin-top: 3px; font-size: 1rem; font-weight: bold; }
    .card-summary p { font-size: 1.25rem; margin: 0; }

    .card-summary:hover {
      transform: translateY(-5px);
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
 
 
  </style>
</head>
<body>

<div class="sidebar">
  <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
  <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
  <a href="/admin/create-tenant"><i class="bi bi-person"></i>Tenant Registration</a>
  <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
  <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
  <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
  <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
<a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
<a href="/admin/visitors"><i class="bi bi-people"></i> Visitors</a>
</div>

   <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> GOYAL PORTAL</a>
      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" onclick="toggleDarkMode()">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end custom-dropdown" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>
          <a href="/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>

 <main class="main-content container mt-5">

   <div class="d-flex justify-content-end">
    <select id="yearSelect" class="form-select w-auto" onchange="filterYear()">
      <% availableYears.forEach(year => { %>
        <option value="<%= year %>" <%= year === selectedYear ? 'selected' : '' %>><%= year %></option>
      <% }) %>
    </select>
  </div>

   <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card-summary bg-income">
        <i class="bi bi-cash-coin"></i>
        <h5>Total Income</h5>
        <p>₱<%= totalIncome.toLocaleString() %></p>
      </div>
    </div>
  </div>

   <div class="row g-4">
     <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-body text-center">
          <h6 class="card-title mb-3 fw-semibold">Monthly Income</h6>
          <canvas id="monthlyIncomeBarChart" height="200"></canvas>
        </div>
      </div>
    </div>

     <div class="col-lg-6">
      <div class="card shadow-sm h-100">
        <div class="card-body d-flex flex-column align-items-center">
          <h6 class="card-title mb-4 fw-semibold text-secondary">Income per Room</h6>
          <canvas id="incomePerRoomPieChart" height="200"></canvas>
        </div>
      </div>
    </div>
  </div>

</main>
<script>
   const monthlyIncomeData = JSON.parse('<%- JSON.stringify(monthlyIncome) %>');
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

  const ctxMonthly = document.getElementById('monthlyIncomeBarChart').getContext('2d');
  new Chart(ctxMonthly, {
    type: 'bar',
    data: {
      labels: months,
      datasets: [{
        label: 'Income',
        data: monthlyIncomeData,
        backgroundColor: 'rgba(25, 135, 84, 0.7)'  
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false },
        title: { display: true, text: 'Monthly Income' }
      },
      scales: {
        y: { beginAtZero: true }
      }
    }
  });

   const incomeRoomLabels = JSON.parse('<%- JSON.stringify(incomeRoomLabels) %>');
  const incomeRoomData = JSON.parse('<%- JSON.stringify(incomeRoomData) %>');

  const ctxIncomeRoom = document.getElementById('incomePerRoomPieChart').getContext('2d');
  new Chart(ctxIncomeRoom, {
    type: 'pie',
    data: {
      labels: incomeRoomLabels,
      datasets: [{
        data: incomeRoomData,
        backgroundColor: incomeRoomLabels.map((_, i) => `hsl(${(i * 360 / incomeRoomLabels.length)}, 70%, 50%)`)
      }]
    },
    options: {
      responsive: true,
      plugins: {
        title: { display: true, text: 'Income per Room' },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.parsed;
              return `${label}: ₱${value.toLocaleString()}`;
            }
          }
        }
      }
    }
  });

   function filterYear() {
    const year = document.getElementById('yearSelect').value;
    window.location.href = `/admin/financial-analytics?year=${year}`;
  }

   document.addEventListener("DOMContentLoaded", () => {
    const isDarkMode = localStorage.getItem("darkMode") === "true";
    if (isDarkMode) {
      document.body.classList.add("dark-mode");
      document.getElementById("darkModeIcon")?.classList.replace("bi-sun", "bi-moon");
    }
  });

  function toggleDarkMode() {
    const body = document.body;
    body.classList.toggle("dark-mode");
    const isDarkMode = body.classList.contains("dark-mode");
    localStorage.setItem("darkMode", isDarkMode);
    const icon = document.getElementById("darkModeIcon");
    icon?.classList.toggle("bi-sun");
    icon?.classList.toggle("bi-moon");
  }
document.addEventListener("DOMContentLoaded", () => {
  const currentPath = window.location.pathname;
  document.querySelectorAll(".sidebar a").forEach(link => {
    if (link.getAttribute("href") === currentPath) {
      link.classList.add("active");
    }
  });
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>