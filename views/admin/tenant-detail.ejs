<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
  body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}
 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}


    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }
    .main-content {
      margin-left: 250px;
      padding: 30px;
      padding-top: 5px;
      width: calc(100% - 250px);
      transition: margin-left 0.3s, width 0.3s;
    }
    .card {
      margin-bottom: 1.5rem;
      border-radius: 0.5rem;
    }

    .card h5 {
      font-weight: 600;
    }

  </style>
</head>
<body>
  
<div class="sidebar">
  <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
  <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
  <a href="/admin/create-tenant"><i class="bi bi-person"></i>Tenant Registration</a>
  <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
  <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
  <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
  <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
<a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
<a href="/admin/visitors"><i class="bi bi-people"></i> Visitors</a>
</div>

  <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> GOYAL PORTAL</a>
      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" onclick="toggleDarkMode()">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end custom-dropdown" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>
        <a href="/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>
  <main class="main-content container">
  <% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <form method="POST" action="/admin/tenant-update/<%= tenant.id %>" class="needs-validation" novalidate>
    <div class="card shadow-sm p-4">
      <h5 class="mb-3">Personal Information</h5>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">First Name</label>
          <input type="text" name="first_name" class="form-control" value="<%= tenant.first_name %>" required />
        </div>
        <div class="col-md-4">
          <label class="form-label">Middle Name</label>
          <input type="text" name="middle_name" class="form-control" value="<%= tenant.middle_name || '' %>" />
        </div>
        <div class="col-md-4">
          <label class="form-label">Last Name</label>
          <input type="text" name="last_name" class="form-control" value="<%= tenant.last_name %>" required />
        </div>

        <div class="col-md-6">
          <label class="form-label">Address</label>
          <input type="text" name="address" class="form-control" value="<%= tenant.address %>" required />
        </div>
        <div class="col-md-2">
          <label class="form-label">Age</label>
          <input type="number" name="age" class="form-control" value="<%= tenant.age %>" required />
        </div>
        <div class="col-md-2">
          <label class="form-label">Contact</label>
          <input type="tel" name="contact_number" class="form-control" value="<%= tenant.contact_number %>" required />
        </div>

        <div class="col-md-4">
          <label class="form-label">Start Lease</label>
          <input type="date" name="start_lease" class="form-control"
                 value="<%= tenant.start_lease ? tenant.start_lease.toISOString().split('T')[0] : '' %>" required />
        </div>

         <div class="col-md-4">
          <label for="roomSelect" class="form-label">Room Number</label>
          <select id="roomSelect" name="room_number" class="form-select" required>
            <option value="" disabled selected>Select Room</option>
          </select>
        </div>

        <div class="col-md-4">
          <label for="bedSelect" class="form-label">Bed</label>
          <select id="bedSelect" name="bed" class="form-select" required>
            <option value="" disabled selected>Select Available Bed</option>
          </select>
        </div>

        <div class="col-md-2">
          <label class="form-label">Monthly Rent</label>
          <input type="number" name="monthly_rent" class="form-control" value="<%= tenant.monthly_rent %>" required />
        </div>
        <div class="col-md-4">
          <label for="deposit" class="form-label">Advance Deposit</label>
          <input type="number" id="deposit" name="deposit" class="form-control"
                 placeholder="₱0.00" min="0" step="0.01" value="<%= tenant.deposit %>" />
        </div>

        <h5>Are you a student?</h5>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="is_student" id="studentYes" value="yes"
                 <%= tenant.is_student ? 'checked' : '' %> />
          <label class="form-check-label" for="studentYes">Yes</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="is_student" id="studentNo" value="no"
                 <%= !tenant.is_student ? 'checked' : '' %> />
          <label class="form-check-label" for="studentNo">No</label>
        </div>

        <div id="studentInfoSection" class="d-flex">
          <div class="col-md-4">
            <input type="text" name="year_level" placeholder="Year Level" class="form-control"
                   value="<%= tenant.year_level %>" />
          </div>
          <div class="col-md-4">
            <input type="text" name="school_name" placeholder="School Name" class="form-control"
                   value="<%= tenant.school_name %>" />
          </div>
        </div>

        <div id="workInfoSection" class="d-flex">
          <div class="col-md-6">
            <input type="text" name="work_place" placeholder="Work Place" class="form-control"
                   value="<%= tenant.work_place %>" />
          </div>
          <div class="col-md-6">
            <input type="text" name="work_position" placeholder="Position" class="form-control"
                   value="<%= tenant.work_position %>" />
          </div>
        </div>
      </div>
    </div>

    <div class="card shadow-sm p-4 mt-3">
      <h5 class="mb-3">Guardian / Emergency Contact</h5>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">First Name</label>
          <input type="text" name="guardian_first_name" class="form-control"
                 value="<%= tenant.guardian_first_name %>" required />
        </div>
        <div class="col-md-4">
          <label class="form-label">Middle Name</label>
          <input type="text" name="guardian_middle_name" class="form-control"
                 value="<%= tenant.guardian_middle_name || '' %>" />
        </div>
        <div class="col-md-4">
          <label class="form-label">Last Name</label>
          <input type="text" name="guardian_last_name" class="form-control"
                 value="<%= tenant.guardian_last_name %>" required />
        </div>
        <div class="col-md-6">
          <label class="form-label">Contact Number</label>
          <input type="tel" name="guardian_contact_number" class="form-control"
                 value="<%= tenant.guardian_contact_number %>" required />
        </div>
        <div class="col-md-6">
          <label class="form-label">Address</label>
          <input type="text" name="guardian_address" class="form-control"
                 value="<%= tenant.guardian_address %>" required />
        </div>
      </div>
    </div>

     <div class="card shadow-sm p-4">
      <h5 class="mb-3">Account Information</h5>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Username</label>
          <input type="text" name="username" class="form-control" value="<%= tenant.username %>" required />
        </div>
        <div class="col-md-4">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="<%= tenant.email %>" required />
        </div>
        <div class="col-md-4">
          <label class="form-label">New Password (optional)</label>
          <input type="password" name="password" class="form-control" placeholder="New Password" />
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
      <button type="submit" class="btn btn-primary">
        <i class="bi bi-person-check-fill"></i> Update Tenant
      </button>
    </div>
  </form>
</main>

 <script>
document.addEventListener("DOMContentLoaded", function () {
  const roomSelect = document.getElementById('roomSelect');
  const bedSelect = document.getElementById('bedSelect');
  let roomData = [];

  fetch("/admin/api/available-beds")
    .then(res => res.json())
    .then(data => {
      roomData = data;
      data.forEach(room => {
        const option = document.createElement('option');
        option.value = room.room_number;  
        option.textContent = room.room_number;
        if (room.room_number === "<%= tenant.room_number %>") {
          option.selected = true;
        }
        roomSelect.appendChild(option);
      });
      roomSelect.dispatchEvent(new Event('change'));
    });

  roomSelect.addEventListener('change', function () {
    const selectedRoom = roomData.find(r => r.room_number == roomSelect.value);
    bedSelect.innerHTML = `<option value="" disabled>Select Available Bed</option>`;
    if (selectedRoom && selectedRoom.beds.length > 0) {
      selectedRoom.beds.forEach(bed => {
        const option = document.createElement('option');
        option.value = bed.bed_number;  
        option.textContent = `Bed ${bed.bed_number} - ${bed.bed_position}`;
        if (bed.bed_number === "<%= tenant.bed %>") {
          option.selected = true;
        }
        bedSelect.appendChild(option);
      });
    }
  });
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>