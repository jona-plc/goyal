<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

/* Center the GOYAL PORTAL text & icon */
.navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.sidebar a.active {
  background-color: #ffd700;
  color: #000;
  font-weight: 600;
  border-radius: 5px;
}
.sidebar a:hover {
  background-color: rgba(255, 215, 0, 0.3);
  color: #000;
}


.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}

    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }

    .main-content {
  margin-left: 250px;
  padding: 2rem;
  padding-top: 1rem;
  width: calc(100% - 250px);
  transition: margin-left 0.3s, width 0.3s;
}


.bg-light {
    --bs-bg-opacity: 1;
    background-color: rgb(203 203 203) !important;
}
    .card {
      margin-top: 5px;
      margin-bottom: 5px;
    }

    .card-body {
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .main-content {
      margin-left: 250px;
      padding: 30px;
      padding-top: 5px;
      width: calc(100% - 250px);
      transition: margin-left 0.3s, width 0.3s;
      min-height: 100vh;
    }

    h5 {
      margin-top: 20px;
      margin-bottom: 15px;
    }

    .hidden-section {
      display: none;
      gap: 15px;
      flex-wrap: wrap;
    }

    
  </style>
</head>
<body>
 
<div class="sidebar">
  <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
  <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
  <a href="/admin/create-tenant"><i class="bi bi-person"></i>Tenant Registration</a>
  <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
  <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
  <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
  <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
  <a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
</div>


  <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> GOYAL PORTAL</a>
      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" onclick="toggleDarkMode()">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end custom-dropdown" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>
        <a href="/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>

  <main class="main-content container">
    <div class="card shadow-sm">
      <div class="card-body">
        <form method="POST" action="/admin/create-tenant" id="tenantForm" class="row g-3">

          <h5>Personal Information</h5>
          <div class="col-md-4">
            <input type="text" name="first_name" placeholder="First Name" class="form-control" required />
          </div>
          <div class="col-md-4">
            <input type="text" name="middle_name" placeholder="Middle Name" class="form-control" />
          </div>
          <div class="col-md-4">
            <input type="text" name="last_name" placeholder="Last Name" class="form-control" required />
          </div>
          <div class="col-md-6">
            <input type="text" name="address" placeholder="Address" class="form-control" required />
          </div>
          <div class="col-md-2">
            <input type="number" name="age" placeholder="Age" min="1" class="form-control" required />
          </div>
          <div class="col-md-4">
            <input type="tel" name="contact_number" placeholder="Contact Number" class="form-control" required />
          </div>
<h5>Rental Information</h5>

<div class="row g-3">
  <div class="col-md-4">
    <label for="start_lease" class="form-label">Start Lease</label>
    <input type="date" id="start_lease" name="start_lease" class="form-control" required />
  </div>

  <div class="col-md-4">
    <label for="deposit" class="form-label">Advance Deposit</label>
    <input type="number" id="deposit" name="deposit" class="form-control" placeholder="₱0.00" min="0" step="0.01" />
  </div>

  
  <div class="col-md-4">
    <label for="monthly_rent" class="form-label">Monthly Rent</label>
    <input type="number" id="monthly_rent" name="monthly_rent" placeholder="₱0.00" min="0" class="form-control" required />
  </div>


  <div class="col-md-4">
    <label for="roomSelect" class="form-label">Room Number</label>
    <select id="roomSelect" name="room_number" class="form-select" required>
      <option value="" disabled selected>Select Room</option>
    </select>
  </div>

  <div class="col-md-4">
    <label for="bedSelect" class="form-label">Bed</label>
    <select id="bedSelect" name="bed" class="form-select" required>
      <option value="" disabled selected>Select Available Bed</option>
    </select>
  </div>

 

          <h5>Are you a student?</h5>
          <div class="col-md-6 form-check form-check-inline">
            <input class="form-check-input" type="radio" name="is_student" id="studentYes" value="yes" required />
            <label class="form-check-label" for="studentYes">Yes</label>
          </div>
          <div class="col-md-6 form-check form-check-inline">
            <input class="form-check-input" type="radio" name="is_student" id="studentNo" value="no" required />
            <label class="form-check-label" for="studentNo">No</label>
          </div>

          <div id="studentInfoSection" class="d-flex hidden-section">
            <div class="col-md-4">
              <input type="text" name="year_level" placeholder="Year Level" class="form-control" />
            </div>
            <div class="col-md-4">
              <input type="text" name="school_name" placeholder="School Name" class="form-control" />
            </div>
          </div>

          <div id="workInfoSection" class="d-flex hidden-section">
            <div class="col-md-6">
              <input type="text" name="work_place" placeholder="Work Place" class="form-control" />
            </div>
            <div class="col-md-6">
              <input type="text" name="work_position" placeholder="Position" class="form-control" />
            </div>
          </div>

          <h5>Guardian / Relative</h5>
          <div class="col-md-4">
            <input type="text" name="guardian_first_name" placeholder="First Name" class="form-control" required />
          </div>
          <div class="col-md-4">
            <input type="text" name="guardian_middle_name" placeholder="Middle Name" class="form-control" />
          </div>
          <div class="col-md-4">
            <input type="text" name="guardian_last_name" placeholder="Last Name" class="form-control" required />
          </div>
          <div class="col-md-6">
            <input type="tel" name="guardian_contact_number" placeholder="Contact Number" class="form-control" required />
          </div>
          <div class="col-md-6">
            <input type="text" name="guardian_address" placeholder="Address" class="form-control" required />
          </div>

          <h5>Account Information</h5>
          <div class="col-md-4">
            <input type="text" name="username" placeholder="Username" class="form-control" required />
          </div>
          <div class="col-md-4">
            <input type="email" name="email" placeholder="Email" class="form-control" required />
          </div>
          <div class="col-md-4">
            <input type="password" name="password" placeholder="Password" class="form-control" required />
          </div>

          <div class="col-12 text-end mt-4">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-person-plus-fill"></i> Create Tenant
            </button>
          </div>
        </form>
      </div>
    </div>
    </main>
 <div class="modal fade" id="resultModal" tabindex="-1" aria-labelledby="resultModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="resultModalLabel">Result</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="resultModalBody">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Automatically highlight active sidebar link
  document.addEventListener("DOMContentLoaded", function () {
    const currentPath = window.location.pathname;
    const sidebarLinks = document.querySelectorAll('.sidebar a');

    sidebarLinks.forEach(link => {
      const linkPath = link.getAttribute('href');
      if (currentPath === linkPath) {
        link.classList.add('active');
      }
    });
  });

  document.addEventListener("DOMContentLoaded", function () {
    const roomSelect = document.getElementById('roomSelect');
    const bedSelect = document.getElementById('bedSelect');
    let roomData = [];
fetch("/admin/api/available-beds")
  .then(res => {
    if (!res.ok) throw new Error('Network response was not ok');
    return res.json();
  })
  .then(data => {
    console.log('Fetched data:', data); // <-- Check this in browser console
    roomData = data;

    data.forEach(room => {
      const option = document.createElement('option');
      option.value = room.room_id;
      option.textContent = room.room_number;
      roomSelect.appendChild(option);
    });
  })
  .catch(err => {
    console.error('Fetch error:', err);
  });

    // When room is selected, populate beds dropdown
    roomSelect.addEventListener('change', function () {
      const selectedRoom = roomData.find(r => r.room_id == roomSelect.value);

      // Clear previous bed options
      bedSelect.innerHTML = `<option value="" disabled selected>Select Available Bed</option>`;

      // Populate bed options for selected room
      if (selectedRoom && selectedRoom.beds.length > 0) {
        selectedRoom.beds.forEach(bed => {
          const option = document.createElement('option');
          option.value = bed.bed_id; // Set bed_id as value for form submission
          option.textContent = `Bed ${bed.bed_number} - ${bed.bed_position}`;
          bedSelect.appendChild(option);
        });
      }
    });
  });
    const studentYesRadio = document.getElementById('studentYes');
    const studentNoRadio = document.getElementById('studentNo');
    const studentSection = document.getElementById('studentInfoSection');
    const workSection = document.getElementById('workInfoSection');

    function setInputsState(section, enabled, required) {
      section.querySelectorAll('input').forEach(input => {
        input.disabled = !enabled;
        input.required = required && enabled;
      });
    }

    function toggleSections() {
      if (studentYesRadio.checked) {
        studentSection.style.display = 'flex';
        workSection.style.display = 'none';

        setInputsState(studentSection, true, false);
        setInputsState(workSection, false, false);
      } else if (studentNoRadio.checked) {
        studentSection.style.display = 'none';
        workSection.style.display = 'flex';

        setInputsState(studentSection, false, false);
        setInputsState(workSection, true, false);
      } else {
        studentSection.style.display = 'none';
        workSection.style.display = 'none';

        setInputsState(studentSection, false, false);
        setInputsState(workSection, false, false);
      }
    }

    studentYesRadio.addEventListener('change', toggleSections);
    studentNoRadio.addEventListener('change', toggleSections);

    toggleSections();

    function toggleDarkMode() {
      document.body.classList.toggle('dark-mode');
      const icon = document.getElementById('darkModeIcon');
      if (document.body.classList.contains('dark-mode')) {
        icon.className = 'bi bi-moon';
      } else {
        icon.className = 'bi bi-sun';
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const status = urlParams.get('status');
      const message = urlParams.get('message');

      if (status) {
        const modalBody = document.getElementById('resultModalBody');
        if (status === 'success') {
          modalBody.textContent = 'Tenant created successfully!';
        } else {
          modalBody.textContent = message || 'Failed to create tenant. Please try again.';
        }
        const resultModal = new bootstrap.Modal(document.getElementById('resultModal'));
        resultModal.show();
      }
    });
  </script>
</body>
</html>
