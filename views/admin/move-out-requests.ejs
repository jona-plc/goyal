<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>

   <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

   <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
   body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}


    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }
  .main-content {
  position: fixed;
  top: 70px; 
  left: 250px; 
  right: 0;
  bottom: 0;
  padding: 30px;
  background-color: #fff;
  overflow-y: auto;  
  border-radius: 8px;
}

    .main-content h2 {
      font-weight: 600;
      font-size: 1.8rem;
      color: #0d6efd;
      border-bottom: 2px solid #0d6efd;
      padding-bottom: 10px;
      margin-bottom: 30px;
    }

    

    .table th {
      font-weight: 600;
      background-color: #cfe2ff;
    }

    .table td,
    .table th {
      padding: 12px 15px;
      vertical-align: middle !important;
      font-size: 0.95rem;
    }

    .table-striped tbody tr:hover {
      background-color: #f9f9f9;
    }

    .action-buttons form {
      display: inline-block;
    }

    .action-buttons button {
      min-width: 80px;
    }

  </style>
</head>
<body>

<div class="sidebar">
  <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
  <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
  <a href="/admin/create-tenant"><i class="bi bi-person"></i>Tenant Registration</a>
  <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
  <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
  <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
  <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
  <a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
</div>

  <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> GOYAL PORTAL</a>
      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" onclick="toggleDarkMode()">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end custom-dropdown" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>
        <a href="/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>
  <div class="main-content">
  <h2>Move-Out Requests</h2>
  <div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
      <thead class="table-primary">
        <tr>
          <th>ID</th>
          <th>Tenant Name</th>
          <th>Room Number</th>
          <th>Reason</th>
          <th>Date Requested</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% if (!requests || requests.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center">No move-out requests found.</td>
          </tr>
        <% } else { %>
          <% requests.forEach(req => { %>
            <tr class="paginated-row">
              <td><%= req.id %></td>
              <td><%= req.first_name %> <%= req.last_name %></td>
              <td><%= req.room_number %></td>
              <td><%= req.reason %></td>
              <td><%= new Date(req.date_requested).toLocaleString() %></td>
              <td><%= req.status %></td>
              <td class="action-buttons">
                <form action="/admin/move-out-approve/<%= req.id %>" method="POST" style="display:inline-block;">
                  <button type="submit" class="btn btn-success btn-sm" <%= req.status === 'Approved' ? 'disabled' : '' %>>
                    Approve
                  </button>
                </form>
                <form action="/admin/move-out-reject/<%= req.id %>" method="POST" style="display:inline-block;">
                  <button type="submit" class="btn btn-danger btn-sm" <%= req.status === 'Rejected' ? 'disabled' : '' %>>
                    Reject
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <nav>
    <ul id="pagination" class="pagination justify-content-center mt-4"></ul>
  </nav>

  <script>
    const rowsPerPage = 5;
    const rows = document.querySelectorAll(".paginated-row");
    const pagination = document.getElementById("pagination");
    const totalPages = Math.ceil(rows.length / rowsPerPage);
    let currentPage = 1;

    function showPage(page) {
      rows.forEach((row, index) => {
        const start = (page - 1) * rowsPerPage;
        const end = start + rowsPerPage;
        row.style.display = (index >= start && index < end) ? "" : "none";
      });

       document.querySelectorAll("#pagination .page-item").forEach((p, i) => {
        p.classList.remove("active");
        if (i === page) p.classList.add("active"); 
      });
    }

    function setupPagination() {
      if (totalPages <= 1) return;

      pagination.innerHTML = `
        <li class="page-item"><a class="page-link" href="#" id="prevBtn">&laquo;</a></li>
      `;
      for (let i = 1; i <= totalPages; i++) {
        pagination.innerHTML += `<li class="page-item ${i === 1 ? 'active' : ''}"><a class="page-link" href="#">${i}</a></li>`;
      }
      pagination.innerHTML += `<li class="page-item"><a class="page-link" href="#" id="nextBtn">&raquo;</a></li>`;

      pagination.addEventListener("click", e => {
        e.preventDefault();
        if (e.target.tagName !== "A") return;

        const text = e.target.textContent;
        if (text === "«" && currentPage > 1) currentPage--;
        else if (text === "»" && currentPage < totalPages) currentPage++;
        else if (!isNaN(text)) currentPage = parseInt(text);
        showPage(currentPage);
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      setupPagination();
      showPage(1);
    });

    function toggleDarkMode() {
      document.body.classList.toggle('dark-mode');
      const icon = document.getElementById('darkModeIcon');
      icon.classList.toggle('bi-sun');
      icon.classList.toggle('bi-moon');
    }
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</div>
