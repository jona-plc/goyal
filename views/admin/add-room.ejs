<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.sidebar a.active {
  background-color: #ffd700;
  color: #000;
  font-weight: 600;
  border-radius: 5px;
}
.sidebar a:hover {
  background-color: rgba(255, 215, 0, 0.3);
  color: #000;
}


.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}

    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }
    .main-content {
  position: fixed;
  top: 70px;
  left: 250px;
  width: calc(100% - 250px);
  height: calc(100vh - 70px);
  overflow-y: auto;
  background-color: #f9f8f3;
  padding: 20px 40px;
  box-sizing: border-box;
}
.bg-light {
    --bs-bg-opacity: 1;
    background-color: rgb(203 203 203) !important;
}
  </style>
</head>

<body>

<div class="sidebar">
  <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
  <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
  <a href="/admin/create-tenant"><i class="bi bi-person"></i>Tenant Registration</a>
  <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
  <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
  <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
  <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
  <a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
</div>

  <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> GOYAL PORTAL</a>
      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" onclick="toggleDarkMode()">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end custom-dropdown" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a>

          </ul>
        </li>
        <a href="/admin/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>
   <div class="main-content container mt-0.5">
  <div class="card mb-4 shadow-sm border-0">
    <div class="card-body">
      <form action="/admin/add-rooms" method="POST">
        <div class="row g-3 align-items-end">
          <div class="col-md-3">
            <label for="room_number" class="form-label">Room Number</label>
            <input type="text" name="room_number" id="room_number" class="form-control" required />
          </div>
          <div class="col-md-3">
            <label for="type" class="form-label">Room Type</label>
            <select name="type" id="type" class="form-select" required>
              <option value="Single">Single</option>
              <option value="Double">Double</option>
              <option value="Double Deck">Double Deck</option>
            </select>
          </div>
          <div class="col-md-2">
            <label for="capacity" class="form-label">Capacity</label>
            <input type="number" name="capacity" id="capacity" class="form-control" min="1" value="4" required />
          </div>
          <div class="col-md-2">
            <label for="status" class="form-label">Status</label>
            <select name="status" id="status" class="form-select">
              <option value="Available" selected>Available</option>
              <option value="Occupied">Occupied</option>
              <option value="Maintenance">Maintenance</option>
            </select>
          </div>
          <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary">Add Room</button>
          </div>
        </div>
      </form>
    </div>
  </div>
<div class="card shadow-sm border-0">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-bordered align-middle table-hover">
        <thead class="table-light">
          <tr>
            <th>Room Number</th>
            <th>Type</th>
            <th>Capacity</th>
            <th>Assigned</th>
            <th>Status</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% rooms.forEach(room => { %>
            <tr>
              <form action="/admin/add-rooms/<%= room.id %>/update" method="POST">
                <td>
                  <input 
                    type="text" 
                    name="room_number" 
                    value="<%= room.room_number %>" 
                    class="form-control form-control-sm" 
                    required 
                  />
                </td>

                <td>
                  <select name="type" class="form-select form-select-sm" required>
                    <option value="Single" <%= room.type === 'Single' ? 'selected' : '' %>>Single</option>
                    <option value="Double" <%= room.type === 'Double' ? 'selected' : '' %>>Double</option>
                    <option value="Double Deck" <%= room.type === 'Double Deck' ? 'selected' : '' %>>Double Deck</option>
                  </select>
                </td>

                <td>
                  <input 
                    type="number" 
                    name="capacity" 
                    value="<%= room.capacity %>" 
                    class="form-control form-control-sm" 
                    min="1" 
                    required 
                  />
                </td>

                <td><%= room.tenant_count %> / <%= room.capacity %></td>

                <td>
                  <select name="status" class="form-select form-select-sm" required>
                    <option value="Available" <%= room.status === 'Available' ? 'selected' : '' %>>Available</option>
                    <option value="Occupied" <%= room.status === 'Occupied' ? 'selected' : '' %>>Occupied</option>
                    <option value="Maintenance" <%= room.status === 'Maintenance' ? 'selected' : '' %>>Maintenance</option>
                  </select>
                </td>

                <td class="text-center">
                  <button type="submit" class="btn btn-success btn-sm px-3">Update</button>
                </td>
              </form> 
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>


<button 
  class="btn btn-danger btn-sm px-3"
  data-bs-toggle="modal"
  data-bs-target="#confirmDeleteModal"
  data-room-id="<%= room.id %>"
  <% if (room.tenant_count > 0) { %> disabled title="Cannot delete assigned room" <% } %>
>
  Delete
</button>

    </td>
  </tr>

            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
 <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Deletion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="deleteRoomForm" method="POST">
        <div class="modal-body">
          Are you sure you want to delete this room? This will delete related beds as well.
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>

 <div class="modal fade" id="statusModal" tabindex="-1" aria-labelledby="statusModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-sm">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title" id="statusModalLabel">Success</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
       </div>
    </div>
  </div>
</div>
<script>
  const deleteModal = document.getElementById('confirmDeleteModal');
  deleteModal.addEventListener('show.bs.modal', function (event) {
    const button = event.relatedTarget;
    const roomId = button.getAttribute('data-room-id');
    
    const form = document.getElementById('deleteRoomForm');
    form.action = `/admin/add-rooms/${roomId}/delete`;
  });
</script>

<script>
   function getQueryParam(param) {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get(param);
  }

   document.addEventListener("DOMContentLoaded", () => {
    const status = getQueryParam("status");

    const statusMessages = {
      added: "Room added successfully.",
      updated: "Room updated successfully.",
      deleted: "Room deleted successfully.",
      error: "Something went wrong. Please try again."
    };

    if (status && statusMessages[status]) {
      const message = statusMessages[status];
      const modalBody = document.querySelector('#statusModal .modal-body');
      const modalTitle = document.querySelector('#statusModalLabel');
      const modalHeader = document.querySelector('#statusModal .modal-header');

      modalBody.textContent = message;

      if (status === 'error') {
        modalTitle.textContent = "Error";
        modalHeader.classList.remove("bg-success");
        modalHeader.classList.add("bg-danger");
      } else {
        modalTitle.textContent = "Success";
        modalHeader.classList.remove("bg-danger");
        modalHeader.classList.add("bg-success");
      }

      const statusModal = new bootstrap.Modal(document.getElementById('statusModal'));
      statusModal.show();
    }
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const isDarkMode = localStorage.getItem("darkMode") === "true";
    if (isDarkMode) {
      document.body.classList.add("dark-mode");
      document.getElementById("darkModeIcon").classList.remove("bi-sun");
      document.getElementById("darkModeIcon").classList.add("bi-moon");
    }
  });

  function toggleDarkMode() {
    const body = document.body;
    body.classList.toggle("dark-mode");

    const isDarkMode = body.classList.contains("dark-mode");
    localStorage.setItem("darkMode", isDarkMode);

    const icon = document.getElementById("darkModeIcon");
    icon.classList.toggle("bi-sun");
    icon.classList.toggle("bi-moon");
  }
</script>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  socket.on('activeUsersUpdate', (count) => {
    document.querySelector('.bg-active p').textContent = count;
  });
</script>
<script>
   const links = document.querySelectorAll('.sidebar a');
  const currentPath = window.location.pathname;

  links.forEach(link => {
    if (link.getAttribute('href') === currentPath) {
      link.classList.add('active');
    }
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>