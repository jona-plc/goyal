<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.sidebar a.active {
  background-color: #ffd700;
  color: #000;
  font-weight: 600;
  border-radius: 5px;
}
.sidebar a:hover {
  background-color: rgba(255, 215, 0, 0.3);
  color: #000;
}


.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}

    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }
    .main-content {
  position: fixed;
  top: 70px;
  left: 250px;
  width: calc(100% - 250px);
  height: calc(100vh - 70px);
  overflow-y: auto;
  background-color: #f9f8f3;
  padding: 20px 40px;
  box-sizing: border-box;
}
.bg-light {
    --bs-bg-opacity: 1;
    background-color: rgb(203 203 203) !important;
}
 .room-card {
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  cursor: pointer;
}

.room-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

.card-header {
  font-weight: 600;
}

.card-body {
  padding: 1rem 1.25rem;
}

.list-group-item {
  font-size: 0.95rem;
}

 @media (max-width: 768px) {
  .main-content {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    padding: 15px 20px;
  }
}
.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #ccc;
  margin-right: 10px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 1.2rem;  
  background-color: #f0f0f0;  
}


  </style>
</head>
<body>


<div class="sidebar">
  <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
  <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
  <a href="/admin/create-tenant"><i class="bi bi-person"></i>Tenant Registration</a>
  <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
  <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
  <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
  <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
<a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
<a href="/admin/visitors"><i class="bi bi-people"></i> Visitors</a>
</div>
  <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> GOYAL PORTAL</a>
      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" onclick="toggleDarkMode()">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end custom-dropdown" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
           <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>
        <a href="/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>

  <main class="main-content">
  <div class="container-fluid py-3">
    <h2 class="fw-bold mb-4 d-flex align-items-center gap-2 text-primary">
  <i class="bi bi-people-fill text-primary"></i> Occupants Directory
</h2>


    <div class="input-group mb-4 w-100" style="max-width: 480px;">
      <input
        type="text"
        id="searchInput"
        class="form-control rounded-start border-secondary"
        placeholder="Search by room number or tenant name..."
        onkeyup="filterRooms()"
      />
      <button class="btn btn-secondary rounded-end" type="button" onclick="filterRooms()">
        <i class="bi bi-search"></i>
      </button>
    </div>
<% if (rooms.length > 0) { %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% rooms.forEach(function(room) { %>
     <div class="col">
  <div class="card room-card h-100 shadow-sm border rounded-3
    <% if (room.tenants.length >= room.capacity) { %>
      border-danger
    <% } else { %>
      border-success
    <% } %>">
    
    <div class="card-header bg-light d-flex justify-content-between align-items-center rounded-top border-bottom">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-door-open-fill fs-4 text-secondary"></i>
        <div>
          <strong class="fs-5 text-dark"><%= room.room_number %></strong><br />
          <small class="text-danger fw-semibold">
            <%= (room.type === 'Single' || room.type === 'Double') ? 'Double Deck' : room.type %>
          </small>
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <% if (room.tenants.length >= room.capacity) { %>
          <span class="badge bg-danger fw-semibold">Full</span>
        <% } else { %>
          <span class="badge bg-success fw-semibold">Available</span>
        <% } %>
        <span class="badge bg-light border text-secondary fw-semibold">Capacity: <%= room.capacity %></span>
      </div>
    </div>

    <div class="card-body bg-white rounded-bottom">
      <% if (room.tenants && room.tenants.length > 0) { %>
        <ul class="list-group list-group-flush">
          <% room.tenants.forEach(function(tenant) { %>
            <li class="list-group-item d-flex align-items-center border-0 px-0 py-2 bg-white">
              <% if (tenant.avatar_url && tenant.avatar_url.trim() !== '') { %>
                <img src="/uploads/<%= tenant.avatar_url %>" class="avatar" alt="Profile Picture">
              <% } else { %>
                <span class="avatar d-flex justify-content-center align-items-center bg-light text-secondary">
                  <i class="bi bi-person-circle fs-4"></i>
                </span>
              <% } %>
              <a href="/admin/occupancy-details/<%= tenant.tenant_id %>" class="text-dark text-decoration-none fw-semibold flex-grow-1">
                <%= tenant.name %>
              </a>
              <span class="badge bg-light border rounded-pill px-3 py-1 text-secondary fw-semibold">
                <%= tenant.bed_number ? `Bed ${tenant.bed_number} - ${tenant.bed_position}` : 'No bed assigned' %>
              </span>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-muted fst-italic mb-0">No tenants assigned in this room.</p>
      <% } %>
    </div>
  </div>
</div>

    <% }) %>
  </div>
<% } else { %>
  <div class="alert alert-secondary text-center">No rooms found.</div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const links = document.querySelectorAll('.sidebar a');
  const currentPath = window.location.pathname;

  links.forEach(link => {
    if (link.getAttribute('href') === currentPath) {
      link.classList.add('active');
    }
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const isDarkMode = localStorage.getItem("darkMode") === "true";
    if (isDarkMode) {
      document.body.classList.add("dark-mode");
      document.getElementById("darkModeIcon").classList.replace("bi-sun", "bi-moon");
    }
  });

  function toggleDarkMode() {
    const body = document.body;
    const icon = document.getElementById("darkModeIcon");
    body.classList.toggle("dark-mode");
    icon.classList.toggle("bi-sun");
    icon.classList.toggle("bi-moon");
    localStorage.setItem("darkMode", body.classList.contains("dark-mode"));
  }

  function filterRooms() {
  const input = document.getElementById("searchInput").value.toLowerCase();
  const cards = document.querySelectorAll(".room-card");

  cards.forEach(card => {
    const roomInfo = card.querySelector(".card-header").innerText.toLowerCase();
    const tenantNames = Array.from(card.querySelectorAll(".list-group-item")).map(item => item.innerText.toLowerCase());
    const match = roomInfo.includes(input) || tenantNames.some(name => name.includes(input));

    card.style.display = match ? "" : "none";
  });
}


</script>
</body>
</html>
