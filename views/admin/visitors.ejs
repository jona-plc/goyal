<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.sidebar a.active {
  background-color: #ffd700;
  color: #000;
  font-weight: 600;
  border-radius: 5px;
}
.sidebar a:hover {
  background-color: rgba(255, 215, 0, 0.3);
  color: #000;
}


.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}

    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }

    .main-content {
  margin-left: 250px;        
  margin-top: 0px;         
  padding: 30px 40px;
  background-color: #f9f8f3;
  min-height: 100vh;         
  box-sizing: border-box;
  transition: all 0.3s ease;
}

     table th {
      background: #007bff;
      color: white;
      text-align: center;
      vertical-align: middle;
    }

    table td {
      vertical-align: middle;
      text-align: center;
    }

    .no-data {
      text-align: center;
      color: #999;
      padding: 20px;
    }

     .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .refresh-text {
      font-size: 14px;
      color: #6c757d;
    }

     .badge-type {
      font-size: 0.85rem;
      padding: 5px 10px;
      border-radius: 10px;
    }

    .badge-inquiry { background-color: #17a2b8; }
    .badge-visitor { background-color: #ffc107; }

     .highlight {
      animation: fadeIn 1s ease-in-out;
      background-color: #d4edda !important;
    }

    @keyframes fadeIn {
      from { background-color: #c3e6cb; }
      to { background-color: #fff; }
    }


  </style>
</head>

<body>
   <div class="sidebar">
    <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
    <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
    <a href="/admin/create-tenant"><i class="bi bi-person"></i> Tenant Registration</a>
    <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
    <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
    <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
    <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
    <a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
    <a href="/admin/visitors" class="active"><i class="bi bi-people"></i> Visitors</a>
  </div>

   <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard">
        <i class="bi bi-speedometer2"></i> GOYAL PORTAL
      </a>

      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" class="btn btn-link">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>

        <a href="/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>

 <main class="main-content">
    <h1><i class="bi bi-person-lines-fill me-2"></i> Visitor Logs</h1>

    <div class="filter-bar">
      <div>
        <label for="dateFilter" class="form-label mb-0 me-2 fw-semibold">Filter by Date:</label>
        <input type="date" id="dateFilter" class="form-control d-inline-block" style="width: 200px;">
      </div>
      <div class="text-end refresh-text">
        Auto-refresh enabled <i class="bi bi-arrow-repeat text-success"></i>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Message</th>
            <th>Type</th>
            <th>IP Address</th>
            <th>User Agent</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody id="visitorTable">
          <% if (visitors && visitors.length > 0) { %>
            <% visitors.forEach(v => { %>
              <tr>
                <td><%= v.id %></td>
                <td><%= v.name || '-' %></td>
                <td><%= v.email || '-' %></td>
                <td><%= v.phone || '-' %></td>
                <td><%= v.title || '-' %></td>
                <td>
                  <span class="badge badge-type <%= v.type === 'inquiry' ? 'badge-inquiry' : 'badge-visitor' %>">
                    <%= v.type %>
                  </span>
                </td>
                <td><%= v.ip_address %></td>
                <td><%= v.user_agent %></td>
                <td><%= new Date(v.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' }) %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="9" class="no-data">No visitor data available</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

   <script src="/socket.io/socket.io.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
  const socket = io();
  const table = document.getElementById('visitorTable');
  const dateFilter = document.getElementById('dateFilter');

  // Function to remove "visitor" rows between 2–5 hours after creation
  function scheduleAutoRemove(row, createdAt, type) {
    if (type !== 'visitor') return; // only visitors auto-disappear

    const now = new Date();
    const createdTime = new Date(createdAt);
    const diff = now - createdTime;

    // Randomize between 2 and 5 hours (in ms)
    const removeAfter = Math.floor(7200000 + Math.random() * (10800000 - 7200000));

    const remainingTime = removeAfter - diff;
    if (remainingTime > 0) {
      setTimeout(() => row.remove(), remainingTime);
    } else {
      row.remove();
    }
  }

  socket.on('new-visitor', visitor => {
    const row = document.createElement('tr');
    row.classList.add('highlight');
    row.innerHTML = `
      <td>${visitor.id}</td>
      <td>${visitor.name || '-'}</td>
      <td>${visitor.email || '-'}</td>
      <td>${visitor.phone || '-'}</td>
      <td>${visitor.title || '-'}</td>
      <td><span class="badge badge-type ${visitor.type === 'inquiry' ? 'badge-inquiry' : 'badge-visitor'}">${visitor.type}</span></td>
      <td>${visitor.ip_address}</td>
      <td>${visitor.user_agent}</td>
      <td>${new Date(visitor.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' })}</td>
    `;
    table.prepend(row);
    scheduleAutoRemove(row, visitor.created_at, visitor.type);
  });

  dateFilter.addEventListener('change', () => {
    const selectedDate = dateFilter.value;
    window.location.href = `?date=${selectedDate}`;
  });

  // Schedule removal for existing visitor rows on page load
  document.querySelectorAll('#visitorTable tr').forEach(tr => {
    const typeCell = tr.cells[5];
    const timeCell = tr.cells[8];
    if (!typeCell || !timeCell) return;

    const type = typeCell.textContent.trim().toLowerCase();
    const timeValue = timeCell.textContent.trim();
    if (timeValue) {
      scheduleAutoRemove(tr, timeValue, type);
    }
  });

  // Optional auto-refresh every 10 minutes
  setInterval(() => location.reload(), 600000);
</script>

</body>
</html>
