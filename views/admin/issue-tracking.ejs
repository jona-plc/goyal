<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
  body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}

.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}

    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }
.main-content {
  position: fixed;
  top: 70px;  
  left: 250px;  
  right: 0;
  bottom: 0;
  padding: 30px;
  background-color: #fff;
  overflow-y: auto;  
  border-radius: 8px;
}


    .main-content h2 {
      font-weight: 600;
      font-size: 1.8rem;
      color: #0d6efd;
      border-bottom: 2px solid #0d6efd;
      padding-bottom: 10px;
      margin-bottom: 30px;
    }

    .table th {
      font-weight: 600;
      font-size: 0.95rem;
      background-color: #cfe2ff;
    }

    .table td {
      font-size: 0.92rem;
      color: #555;
    }

    .table td,
    .table th {
      padding: 12px 15px !important;
      vertical-align: middle !important;
    }

    .table tbody tr:hover {
      background-color: #f9f9f9;
    }

    .badge {
      font-size: 0.85rem;
      padding: 6px 10px;
      border-radius: 12px;
    }

    form.d-flex.gap-1 {
      align-items: center;
    }

    select.form-select-sm {
      min-width: 120px;
    }

   
  </style>
</head>
<body>

<div class="sidebar">
  <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
  <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
  <a href="/admin/create-tenant"><i class="bi bi-person"></i>Tenant Registration</a>
  <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
  <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
  <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
  <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
  <a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
</div>

  <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> GOYAL PORTAL</a>
      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" onclick="toggleDarkMode()">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end custom-dropdown" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>
        <a href="/admin/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>
 <main class="main-content">
  <h2>Issue Tracking</h2>
  <div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
    <thead class="table-primary">
  <tr>
    <th>ID</th>
    <th>Tenant</th>
    <th>Room</th>
    <th>Issue Type</th>
    <th>Description</th>
    <th>Image</th> 
    <th>Status</th>
    <th>Date Reported</th>
    <th>Date Resolved</th>
    <th>Actions</th>
  </tr>
</thead>

<tbody>
  <% if (!issues.length) { %>
    <tr>
      <td colspan="10" class="text-center">No issues reported.</td>
    </tr>
  <% } else { %>
    <% issues.forEach(issue => { %>
      <tr>
        <td><%= issue.id %></td>
        <td><%= issue.first_name %> <%= issue.last_name %></td>
        <td><%= issue.room_number %></td>
        <td><%= issue.issue_type %></td>
        <td><%= issue.description %></td>
        <td>
  <% if (issue.image_url) { %>
  <img src="<%= issue.image_url %>" alt="Issue Image" style="width:60px; height:60px; object-fit:cover; border-radius:5px;" />
  <% } else { %>
    <span>No image</span>
  <% } %>
</td>

        </td>
        <td>
          <span class="badge <%= 
            issue.status === 'Pending' ? 'bg-warning text-dark' : 
            issue.status === 'In Progress' ? 'bg-info text-dark' : 
            'bg-success' %>">
            <%= issue.status %>
          </span>
        </td>
        <td><%= new Date(issue.date_reported).toLocaleString() %></td>
        <td><%= issue.date_resolved ? new Date(issue.date_resolved).toLocaleString() : '-' %></td>
        <td>
         <form action="/admin/issue-tracking/<%= issue.id %>/status" method="POST" class="d-flex gap-1 align-items-center">
  <input type="hidden" name="currentPage" value="<%= currentPage %>">
  <select name="status" class="form-select form-select-sm">
    <option value="Pending" <%= issue.status === 'Pending' ? 'selected' : '' %>>Pending</option>
    <option value="In Progress" <%= issue.status === 'In Progress' ? 'selected' : '' %>>In Progress</option>
    <option value="Resolved" <%= issue.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
  </select>
  <button type="submit" class="btn btn-sm btn-primary">Update</button>
</form>

        </td>
      </tr>
    <% }) %>
  <% } %>
</tbody>

    </table>
  </div>
<nav>
  <ul id="pagination" class="pagination justify-content-center mt-4"></ul>
</nav>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
  const table = document.querySelector("table tbody");
  const rows = Array.from(table.querySelectorAll("tr"));
  const rowsPerPage = 10;
  const pagination = document.getElementById("pagination");

  function displayPage(page) {
    table.innerHTML = "";
    const start = (page - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    rows.slice(start, end).forEach(row => table.appendChild(row));

    pagination.innerHTML = "";
    const totalPages = Math.ceil(rows.length / rowsPerPage);

     const prev = document.createElement("li");
    prev.classList.add("page-item");
    prev.innerHTML = `<a class="page-link" href="#">«</a>`;
    prev.addEventListener("click", e => {
      e.preventDefault();
      if (page > 1) displayPage(page - 1);
    });
    pagination.appendChild(prev);

     for (let i = 1; i <= totalPages; i++) {
      const li = document.createElement("li");
      li.classList.add("page-item", page === i ? "active" : "");
      li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
      li.addEventListener("click", e => {
        e.preventDefault();
        displayPage(i);
      });
      pagination.appendChild(li);
    }

     const next = document.createElement("li");
    next.classList.add("page-item");
    next.innerHTML = `<a class="page-link" href="#">»</a>`;
    next.addEventListener("click", e => {
      e.preventDefault();
      if (page < totalPages) displayPage(page + 1);
    });
    pagination.appendChild(next);
  }

  if (rows.length > 0) displayPage(1);
});

  function toggleDarkMode() {
    document.body.classList.toggle('dark-mode');
    const icon = document.getElementById('darkModeIcon');
    if (document.body.classList.contains('dark-mode')) {
      icon.classList.remove('bi-sun');
      icon.classList.add('bi-moon');
    } else {
      icon.classList.remove('bi-moon');
      icon.classList.add('bi-sun');
    }
  }
</script>

</body>
</html>
