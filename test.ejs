<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
   body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}

.sidebar a.active {
  background-color: #ffd700;
  color: #000;
  font-weight: 600;
  border-radius: 5px;
}
.sidebar a:hover {
  background-color: rgba(255, 215, 0, 0.3);
  color: #000;
}


.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}
    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }
    .card {
      margin-top: 5px;
      margin-bottom: 5px;
    }

    .card-body {
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .card-summary {
      text-align: center;
      padding: 20px;
      border-radius: 10px;
      color: #fff;
    }

    .bg-active { background-color: #0d6efd; }
    .bg-monthly { background-color: #198754; }
    .bg-total { background-color: #6c757d; }
    .bg-tenant { background-color: #20c997; }
    .bg-settings { background-color: #fd7e14; }

    .card-summary i { font-size: 1.75rem; }
    .card-summary h5 { margin-top: 8px; font-size: 1rem; font-weight: bold; }
    .card-summary p { font-size: 1.25rem; margin: 0; }

    .dashboard-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }


    .main-content {
  margin-left: 250px;
  padding: 2rem;
  padding-top: 1rem;
  width: calc(100% - 250px);
  transition: margin-left 0.3s, width 0.3s;
}


  </style>
</head>
<body>


<div class="sidebar">
  <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
  <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
  <a href="/admin/create-tenant"><i class="bi bi-person"></i>Tenant Registration</a>
  <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
  <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
  <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
  <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
<a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
<a href="/admin/visitors"><i class="bi bi-people"></i> Visitors</a>
</div>
  <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard"><i class="bi bi-speedometer2"></i> GOYAL PORTAL</a>
      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" onclick="toggleDarkMode()">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end custom-dropdown" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>
        <a href="/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>

<main class="main-content container my-5">

  <!-- Flash Modal -->
  <div class="modal fade" id="flashModal" tabindex="-1" aria-labelledby="flashModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <% if (success && success.length > 0) { %>
          <div class="modal-header bg-success text-white">
            <h5 class="modal-title" id="flashModalLabel">Success</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body"><%= success %></div>
        <% } else if (error && error.length > 0) { %>
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title" id="flashModalLabel">Error</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body"><%= error %></div>
        <% } %>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Search + Archive Button -->
  <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <h4 class="fw-bold mb-0 text-primary">
      <i class="bi bi-people-fill me-2"></i> Registered Tenants
    </h4>
    <div class="d-flex align-items-center gap-2">
      <input type="text" id="tenantSearch" class="form-control" placeholder="Search tenants..." style="max-width: 300px;">
      <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#archiveModalTooltip" title="Archived Tenants">
        <i class="bi bi-archive"></i>
      </button>
    </div>
  </div>

  <!-- Tenants Table -->
  <% if (tenants && tenants.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Status</th>
            <th>Registered At</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="tenantTableBody">
          <% tenants.forEach(tenant => { %>
            <tr data-id="<%= tenant.id %>" data-firstname="<%= (tenant.first_name || '').toLowerCase() %>" data-lastname="<%= (tenant.last_name || '').toLowerCase() %>">
              <td><%= tenant.username %></td>
              <td><%= tenant.email %></td>
              <td>
                <% if (tenant.is_active) { %>
                  <span class="badge bg-success">Active</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inactive</span>
                <% } %>
              </td>
              <td>
                <% if (tenant.created_at) { %>
                  <%= new Date(tenant.created_at).toLocaleDateString() %>
                <% } else { %>
                  N/A
                <% } %>
              </td>
              <td>
                <a href="/admin/tenant-view/<%= tenant.id %>" class="btn btn-sm btn-primary">
                  <i class="bi bi-eye"></i> Edit
                </a>
                <button type="button" class="btn btn-sm btn-warning ban-btn" data-id="<%= tenant.id %>" data-bs-toggle="modal" data-bs-target="#banModal">
                  <i class="bi bi-slash-circle"></i> Ban
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-3">
      <nav id="paginationNav" class="pagination"></nav>
    </div>

  <% } else { %>
    <p>No tenants registered yet.</p>
  <% } %>

  <!-- Ban Modal -->
  <div class="modal fade" id="banModal" tabindex="-1" aria-labelledby="banModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <form id="banTenantForm" method="POST" action="">
          <div class="modal-header bg-warning text-dark">
            <h5 class="modal-title" id="banModalLabel">Confirm Ban</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">Are you sure you want to ban this tenant? They will be moved to archive.</div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning">Yes, Ban</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<!-- JS -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const flashModal = new bootstrap.Modal(document.getElementById('flashModal'));
    flashModal.show();
  });
</script>
<% } %>

<script>
  const banModal = document.getElementById('banModal');
const banForm = document.getElementById('banTenantForm');

banModal.addEventListener('show.bs.modal', event => {
  const button = event.relatedTarget;
  const tenantId = button.getAttribute('data-id');
  banForm.action = `/admin/tenant-ban/${tenantId}`;
});

  const links = document.querySelectorAll('.sidebar a');
  const currentPath = window.location.pathname;

  links.forEach(link => {
    if (link.getAttribute('href') === currentPath) {
      link.classList.add('active');
    }
  });
</script>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('tenantSearch');
    const tableBody = document.querySelector('table tbody');
    const paginationNav = document.getElementById('paginationNav');
    const rowsPerPage = 7;
    let currentPage = 1;

    function showPage(page) {
      currentPage = page;
      const rows = Array.from(tableBody.rows);
      const filter = searchInput.value.toLowerCase();

      const filteredRows = rows.filter(row => {
        const username = row.cells[0].textContent.toLowerCase();
        const email = row.cells[1].textContent.toLowerCase();
        const firstName = row.dataset.firstname || '';
        const lastName = row.dataset.lastname || '';
        return username.includes(filter) || email.includes(filter) || firstName.includes(filter) || lastName.includes(filter);
      });

      rows.forEach(r => r.style.display = 'none');
      const start = (page - 1) * rowsPerPage;
      const end = start + rowsPerPage;
      filteredRows.slice(start, end).forEach(row => row.style.display = '');

      renderPagination(filteredRows);
    }

    function renderPagination(filteredRows) {
      paginationNav.innerHTML = '';
      const totalPages = Math.ceil(filteredRows.length / rowsPerPage);

      if (totalPages <= 1) {
        paginationNav.style.display = 'none';
        return;
      } else {
        paginationNav.style.display = 'flex';
      }

      const prevBtn = document.createElement('button');
      prevBtn.textContent = '« Prev';
      prevBtn.classList.add('btn', 'btn-sm', 'mx-1');
      prevBtn.disabled = currentPage === 1;
      prevBtn.addEventListener('click', () => showPage(currentPage - 1));
      paginationNav.appendChild(prevBtn);

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.textContent = i;
        btn.classList.add('btn', 'btn-sm', 'mx-1');
        if (i === currentPage) {
          btn.classList.add('btn-primary');
        } else {
          btn.classList.add('btn-outline-primary');
        }
        btn.addEventListener('click', () => showPage(i));
        paginationNav.appendChild(btn);
      }

      const nextBtn = document.createElement('button');
      nextBtn.textContent = 'Next »';
      nextBtn.classList.add('btn', 'btn-sm', 'mx-1');
      nextBtn.disabled = currentPage === totalPages;
      nextBtn.addEventListener('click', () => showPage(currentPage + 1));
      paginationNav.appendChild(nextBtn);
    }

    searchInput.addEventListener('input', () => showPage(1));
    showPage(1);

    
    const deleteModal = document.getElementById('deleteModal');
    const deleteForm = document.getElementById('deleteTenantForm');
    deleteModal.addEventListener('show.bs.modal', event => {
      const button = event.relatedTarget;
      const tenantId = button.getAttribute('data-id');
      deleteForm.action = `/admin/tenant-delete/${tenantId}`;
    });
  });


  
  function toggleDarkMode() {
    document.body.classList.toggle('dark-mode');

  
    const icon = document.getElementById('darkModeIcon');
    if (document.body.classList.contains('dark-mode')) {
      icon.classList.remove('bi-sun');
      icon.classList.add('bi-moon');
    } else {
      icon.classList.remove('bi-moon');
      icon.classList.add('bi-sun');
    }
  }
   const deleteModal = document.getElementById('deleteModal');
      const deleteForm = document.getElementById('deleteTenantForm');
      deleteModal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget;
        const tenantId = button.getAttribute('data-id');
        deleteForm.action = `/admin/tenant-delete/${tenantId}`;
      });
    
</script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>

</body>
</html>
