<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>GOYAL BOARDING HOUSE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    html, body {
  height: 100%;
  margin: 0;
  padding: 0;
  overflow-x: hidden; 
}

    body {
      background-color: #f9f8f3;
      padding-top: 70px;
      margin: 0;
      font-family: 'Poppins', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: calc(100% - 250px);
  margin-left: 250px;
  z-index: 1000;
  background: whitesmoke;
  box-shadow: 0 4px 10px rgba(199, 15, 15, 0.15);
}

 .navbar-brand {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #4b2626 !important;
  font-weight: 700;
  letter-spacing: 1px;
  text-shadow: 0 0 5px rgba(255,255,255,0.5);
  font-size: 1.4rem;
  display: flex;
  align-items: center;
  gap: 8px;
}
.sidebar a.active {
  background-color: #ffd700;
  color: #000;
  font-weight: 600;
  border-radius: 5px;
}
.sidebar a:hover {
  background-color: rgba(255, 215, 0, 0.3);
  color: #000;
}


.custom-dropdown .dropdown-item:hover {
  background: #b80707;
  color: #fff;
  transform: translateX(5px);
}

    .navbar .nav-link,
    #darkModeToggle {
      color: #302828 !important;
      font-weight: 600;
    }

    #darkModeToggle:hover {
      color: #b80707;
    }
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100%;
      width: 250px;
      background: linear-gradient( #000f06, #3d3f39b7, #0f1113d7);
      padding-top: 90px;
      color: #fff;
      z-index: 1000;
      box-shadow: 3px 0 10px rgba(0,0,0,0.1);
    }

    .sidebar a {
      display: block;
      padding: 15px;
      color: #f7f5f1;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 600;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s;
    }

    .sidebar a:hover {
      background-color: rgba(255, 255, 255, 0.3);
      padding-left: 25px;
      color: #000;
    }
  
    .dark-mode {
      background-color: #111;
      color: #e1e1e1;
    }

    .dark-mode .navbar {
      background: linear-gradient(45deg, #2c2c2c, #1a1a1a);
    }

    .dark-mode .sidebar {
      background: #1c1c1c;
      color: #fff;
    }

    .dark-mode .sidebar a {
      color: #fff;
    }

    .dark-mode .sidebar a:hover {
      background-color: #ffd700;
      color: #000;
    }

    .dark-mode .card-summary {
      background: linear-gradient(135deg, #444, #222);
      color: #ffd700;
    }

    .dark-mode .navbar-brand {
      color: #ffd700 !important;
    }

    .dark-mode #darkModeToggle {
      color: #ffd700 !important;
    }

    .btn-danger {
      background: linear-gradient(45deg, #b30000, #ff4d4d);
      border: none;
    }

    .btn-danger:hover {
      background: linear-gradient(45deg, #ff4d4d, #ff6666);
      box-shadow: 0 0 15px rgba(255,0,0,0.4);
    }

    .main-content {
  margin-left: 250px;        
  margin-top: 0px;         
  padding: 30px 40px;
  background-color: #f9f8f3;
  min-height: 100vh;         
  box-sizing: border-box;
  transition: all 0.3s ease;
}
table td, table th {
  word-break: break-word;  
  max-width: 150px;        
  text-align: center;      
}

table {
  table-layout: fixed;     
  width: 100%;
}

     table th {
      background: #007bff;
      color: white;
      text-align: center;
      vertical-align: middle;
    }

    table td {
      vertical-align: middle;
      text-align: center;
    }

    .no-data {
      text-align: center;
      color: #999;
      padding: 20px;
    }

     .filter-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .refresh-text {
      font-size: 14px;
      color: #6c757d;
    }

     .badge-type {
      font-size: 0.85rem;
      padding: 5px 10px;
      border-radius: 10px;
    }

    .badge-inquiry { background-color: #17a2b8; }
    .badge-visitor { background-color: #ffc107; }

     .highlight {
      animation: fadeIn 1s ease-in-out;
      background-color: #d4edda !important;
    }

    @keyframes fadeIn {
      from { background-color: #c3e6cb; }
      to { background-color: #fff; }
    }


  </style>
</head>

<body>
   <div class="sidebar">
    <a href="/admin/dashboard"><i class="bi bi-house-door"></i> Dashboard</a>
    <a href="/admin/financial-analytics"><i class="bi bi-bar-chart"></i> Financial Analytics</a>
    <a href="/admin/create-tenant"><i class="bi bi-person"></i> Tenant Registration</a>
    <a href="/admin/tenant-information"><i class="bi bi-person-gear"></i> Manage Tenants</a>
    <a href="/admin/occupants"><i class="bi bi-collection"></i> Occupants</a>
    <a href="/admin/payments"><i class="bi bi-credit-card-2-front"></i> Payment Transaction</a>
    <a href="/admin/add-rooms"><i class="bi bi-door-open"></i> Manage Rooms</a>
    <a href="/admin/messaging"><i class="bi bi-chat"></i> Messaging</a>
    <a href="/admin/visitors" class="active"><i class="bi bi-people"></i> Visitors</a>
  </div>

   <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/admin/dashboard">
        <i class="bi bi-speedometer2"></i> GOYAL PORTAL
      </a>

      <div class="navbar-nav ms-auto">
        <button id="darkModeToggle" class="btn btn-link">
          <span id="darkModeIcon" class="bi bi-sun"></span>
        </button>

        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" id="featuresDropdown" data-bs-toggle="dropdown">
            <i class="bi bi-grid"></i> Features
          </a>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="featuresDropdown">
            <li><a class="dropdown-item" href="/admin/issue-tracking">Issue Tracking</a></li>
            <li><a class="dropdown-item" href="/admin/move-out-requests">Move-Out Requests</a></li>
            <li><a class="dropdown-item" href="/admin/announcements">Announcements</a></li>
          </ul>
        </li>

        <a href="/logout" class="btn btn-danger ms-2">
          <i class="bi bi-box-arrow-right"></i> Logout
        </a>
      </div>
    </div>
  </nav>
  <main class="main-content p-4">
    <h1><i class="bi bi-person-lines-fill me-2"></i> Visitor Logs</h1>

    <!-- Filter Bar -->
    <div class="filter-bar d-flex justify-content-between align-items-center mb-3">
      <div>
        <label for="dateFilter" class="form-label mb-0 me-2 fw-semibold">Filter by Date:</label>
        <input type="date" id="dateFilter" class="form-control d-inline-block" style="width: 200px;">
        <button id="resetFilter" class="btn btn-outline-secondary btn-sm ms-2">Reset</button>
      </div>

      <div class="text-end refresh-text">
        Auto-refresh enabled <i class="bi bi-arrow-repeat text-success"></i>
        &nbsp;
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#inquiryModal">
          Inquiries <span id="inquiryBadge" class="badge bg-danger">0</span>
        </button>
      </div>
    </div>

    <!-- Visitor Table -->
    <table class="table table-striped" id="visitorTable">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Type</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody id="visitorTableBody"></tbody>
    </table>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-center align-items-center mt-3 gap-2">
      <button id="prevPage" class="btn btn-outline-primary btn-sm">Previous</button>
      <span id="pageInfo" class="fw-semibold"></span>
      <button id="nextPage" class="btn btn-outline-primary btn-sm">Next</button>
    </div>

    <!-- Inquiry Modal -->
    <div class="modal fade" id="inquiryModal" tabindex="-1" aria-labelledby="inquiryModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="inquiryModalLabel">Inquiry Logs</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Message</th>
                  <th>Time</th>
                </tr>
              </thead>
              <tbody id="inquiryTable"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>

  <script>
  const socket = io();

  const dateFilter = document.getElementById('dateFilter');
  const resetFilter = document.getElementById('resetFilter');
  const inquiryTable = document.getElementById('inquiryTable');
  const inquiryBadge = document.getElementById('inquiryBadge');
  const visitorTableBody = document.getElementById('visitorTableBody');
  const prevPageBtn = document.getElementById('prevPage');
  const nextPageBtn = document.getElementById('nextPage');
  const pageInfo = document.getElementById('pageInfo');

  let allVisitors = []; // lahat ng visitors
  let filteredVisitors = []; // filtered by date
  let currentPage = 1;
  const rowsPerPage = 5;

  // Render function for main table
  function renderTable() {
    visitorTableBody.innerHTML = '';

    const start = (currentPage - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    const visibleRows = filteredVisitors.slice(start, end);

    visibleRows.forEach(data => {
      const row = document.createElement('tr');
      row.setAttribute('data-date', new Date(data.created_at).toISOString().split('T')[0]);
      row.innerHTML = `
        <td>${data.id}</td>
        <td>${data.name || '-'}</td>
        <td>${data.type || '-'}</td>
        <td>${new Date(data.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' })}</td>
      `;
      visitorTableBody.appendChild(row);
    });

    const totalPages = Math.ceil(filteredVisitors.length / rowsPerPage);
    pageInfo.textContent = `Page ${currentPage} of ${totalPages || 1}`;
    prevPageBtn.disabled = currentPage === 1;
    nextPageBtn.disabled = currentPage === totalPages || totalPages === 0;
  }

  // Update filtered data and re-render
  function applyFilter() {
    const selectedDate = dateFilter.value;
    if (selectedDate) {
      filteredVisitors = allVisitors.filter(v => {
        const vDate = new Date(v.created_at).toISOString().split('T')[0];
        return vDate === selectedDate;
      });
    } else {
      filteredVisitors = [...allVisitors];
    }
    currentPage = 1;
    renderTable();
  }

  // Socket listener for new data
  socket.on("newVisitor", data => {
    allVisitors.unshift(data);
    applyFilter();

    // Add to inquiry modal if inquiry type
    if (data.type === 'inquiry') {
      const modalRow = document.createElement('tr');
      modalRow.innerHTML = `
        <td>${data.id}</td>
        <td>${data.name || '-'}</td>
        <td>${data.email || '-'}</td>
        <td>${data.phone || '-'}</td>
        <td>${data.title || '-'}</td>
        <td>${new Date(data.created_at).toLocaleString('en-PH', { timeZone: 'Asia/Manila' })}</td>
      `;
      inquiryTable.prepend(modalRow);
      inquiryBadge.textContent = parseInt(inquiryBadge.textContent) + 1;
    }
  });

  // Pagination controls
  prevPageBtn.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderTable();
    }
  });

  nextPageBtn.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredVisitors.length / rowsPerPage);
    if (currentPage < totalPages) {
      currentPage++;
      renderTable();
    }
  });

  // Filter handlers
  dateFilter.addEventListener('change', applyFilter);
  resetFilter.addEventListener('click', () => {
    dateFilter.value = '';
    applyFilter();
  });

  // Reset badge when modal opens
  const inquiryModal = document.getElementById('inquiryModal');
  inquiryModal.addEventListener('show.bs.modal', () => {
    inquiryBadge.textContent = 0;
  });

  // Initial setup
  applyFilter();
  </script>
</body>
</html>